#!/usr/bin/env bash
# Refuse to publish private network details (scripts/public-check), or a commit that embeds a
# repository nothing declares.
#
# The backstop for pre-commit: a commit made with --no-verify, or by a tool that never runs
# hooks, still has to get past this before it reaches a remote. The failure it prevents is the
# worst of the family -- a gitlink that lands on GitHub and clones as an empty directory, with
# nothing in the clone to say what is missing.
#
# It judges the tip tree of each ref being pushed: that is the state a clone would fetch. A
# history that embedded something and then removed it is not re-examined, which keeps a large
# first push from turning into a walk of every commit; pre-commit is what stops those existing.
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0
here=$(cd "$(dirname "$0")" && pwd)
public_check=$(cd "$here/../.." && pwd)/scripts/public-check

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue                 # a ref being deleted

  # What these commits add must not name this household: every repository here is public.
  if [[ -x $public_check ]] && ! "$public_check" --tip "$local_sha" >&2; then
    printf '\nERROR: refusing to push %s: see above.\n\n' "$local_ref" >&2
    status=1
  fi

  links=$(git ls-tree -r "$local_sha" | awk '$1 == "160000" { print $4 }')
  [[ -n $links ]] || continue

  decl=$(mktemp)
  trap 'rm -f "$decl"' EXIT
  if git cat-file -e "$local_sha:.gitmodules" 2>/dev/null; then
    git show "$local_sha:.gitmodules" > "$decl"
  else
    : > "$decl"
  fi

  declare -A declared=()
  while read -r key value; do
    [[ -n $key ]] || continue
    name=${key#submodule.}; name=${name%.path}
    if git config -f "$decl" --get "submodule.$name.url" >/dev/null 2>&1; then
      declared["$value"]=1
    fi
  done < <(git config -f "$decl" --get-regexp '^submodule\..*\.path$' 2>/dev/null || true)

  while IFS= read -r path; do
    [[ -n $path ]] || continue
    [[ -n ${declared[$path]:-} ]] && continue
    printf '\nERROR: refusing to push %s: it contains a repository nothing declares:\n\n' "$local_ref" >&2
    printf '  %s\n\n' "$path" >&2
    printf 'Fix it in the commit and push again: declare it (git submodule add <url> %s) or remove\n' "$path" >&2
    printf 'it from the index (git rm --cached -f -r %s).\n\n' "$path" >&2
    status=1
  done <<< "$links"
done

exit $status
