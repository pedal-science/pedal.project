#!/usr/bin/env python3
"""scripts/public-check: keep private network details out of the public repositories.

Every repository in the workspace is public. This looks for what should not be in one: LAN
addresses, global IPv6 addresses, MAC addresses, secrets, and, where it can read them, this
household's own details (the external address, the Wi-Fi name, the IPv6 prefix, the addresses in
~/.ssh/config). Those last are read at the moment of the check and stored nowhere, and nothing it
reports repeats a value: the line it was found on is enough.

    scripts/public-check                        what this push would add (the tree's commits that
                                                no remote has), from this repository
    scripts/public-check --tip SHA              the same, from that commit
    scripts/public-check --range A..B           what those commits add
    scripts/public-check --all                  every tracked file, as it stands
    scripts/public-check --workspace            --all, for every repository in workspace.repos
    scripts/public-check --no-live              without this household's details: CI has none

The pre-push hook (tools/git-hooks/pre-push) and CI run it. A match stops the push. Mask the value,
which is nearly always right for a log; or, if it is meant to be there, add the file's path to the
repository's .public-check-allow with the reason:

    bench-results/old-run/*.txt    # logs from before this check; left as they are, 2026-11-03

A name and an email address are not looked for: the owner is content to publish them.
"""

import argparse
import fnmatch
import os
import re
import subprocess
import sys

ALLOW_FILE = ".public-check-allow"

# Addresses a LAN address may be without identifying anything: a network rather than a host.
_LAN = rb"(?:192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})"
PATTERNS = [
    ("LAN address", re.compile(rb"(?<![\d.])" + _LAN + rb"(?![\d.])")),
    (
        "global IPv6 address",
        re.compile(rb"(?<![0-9a-fA-F:.])2[0-9a-fA-F]{3}(?::[0-9a-fA-F]{1,4}){3}:[0-9a-fA-F:]*[0-9a-fA-F]"),
    ),
    ("MAC address", re.compile(rb"(?<![0-9a-fA-F:])[0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5}(?![0-9a-fA-F:])")),
    ("private key", re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY")),
    ("GitHub token", re.compile(rb"\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})")),
    ("1Password token", re.compile(rb"\bops_[A-Za-z0-9+/=_-]{40,}")),
    ("AWS key", re.compile(rb"\bAKIA[0-9A-Z]{16}\b")),
]


def harmless(kind, text):
    """Things that match a pattern and say nothing about anybody."""
    if kind == "LAN address":
        # A network, or the default bridge address libvirt or docker gives every machine.
        return text.endswith(b".0") or text in (b"192.168.122.1", b"172.17.0.1")
    if kind == "global IPv6 address":
        return text.lower().startswith(b"2001:db8:")  # the documentation prefix
    if kind == "MAC address":
        return text.lower() in (b"00:00:00:00:00:00", b"ff:ff:ff:ff:ff:ff")
    return False


def run(*cmd, timeout=5):
    """A command's stdout as text, or '' if it could not say. Its stderr is never shown."""
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return ""
    return done.stdout.strip() if done.returncode == 0 else ""


def read_live():
    """{what it is: value} for this household, as of now. A value it cannot read is simply absent,
    and macOS's '<redacted>' Wi-Fi name counts as not read."""
    live = {}
    external = run("dig", "+short", "+time=3", "+tries=2", "txt", "ch", "whoami.cloudflare", "@1.1.1.1", timeout=8)
    if external:
        live["external address"] = external.splitlines()[0].strip('"')
    # The Mac hides the Wi-Fi name, so ask piv, which is on the same network and always up.
    ssh = ("ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "piv")
    ssid = run(*ssh, "nmcli -t -f active,ssid dev wifi list --rescan no 2>/dev/null | sed -n 's/^yes://p'")
    if ssid and "redacted" not in ssid:
        live["Wi-Fi name"] = ssid.splitlines()[0]
    global_v6 = run(*ssh, "ip -6 addr show scope global | awk '/inet6/{print $2; exit}'")
    if global_v6:
        live["IPv6 prefix"] = ":".join(global_v6.split(":")[:3]) + ":"
    # Hosts this machine reaches by a name or an address of their own, rather than a bare LAN name.
    try:
        with open(os.path.expanduser("~/.ssh/config"), encoding="utf-8", errors="replace") as config:
            for line in config:
                match = re.match(r"\s*HostName\s+(\S*\.\S+)\s*$", line, re.IGNORECASE)
                if match and not match.group(1).endswith(".local"):
                    live[f"ssh address {len(live)}"] = match.group(1)
    except OSError:
        pass
    return live


def findings_in(line, live):
    """Every (kind) that a line of bytes matches. Only the kind: never the value."""
    found = []
    for kind, pattern in PATTERNS:
        if any(not harmless(kind, match.group(0)) for match in pattern.finditer(line)):
            found.append(kind)
    for kind, value in live.items():
        if value.encode() in line:
            found.append(kind)
    return found


def allowed_paths(repo):
    """The patterns in a repository's allow file, without their reasons."""
    try:
        with open(os.path.join(repo, ALLOW_FILE), encoding="utf-8") as allow:
            return [line.split("#", 1)[0].strip() for line in allow if line.split("#", 1)[0].strip()]
    except OSError:
        return []


def is_allowed(path, patterns):
    return any(fnmatch.fnmatch(path, pattern) for pattern in patterns)


def scan_tree(repo, live, patterns):
    """[(path, line number, kind)] over every tracked file as it stands, binary ones included."""
    results = []
    listing = subprocess.run(["git", "-C", repo, "ls-files", "-z"], capture_output=True, check=True).stdout
    for raw in listing.split(b"\0"):
        path = raw.decode(errors="replace")
        if not path or path == ALLOW_FILE or is_allowed(path, patterns):
            continue
        full = os.path.join(repo, path)
        if not os.path.isfile(full) or os.path.islink(full):
            continue
        with open(full, "rb") as handle:
            for number, line in enumerate(handle, 1):
                results.extend((path, number, kind) for kind in findings_in(line, live))
    return results


def scan_commits(repo, revisions, live, patterns):
    """[(path or 'commit message', line number, kind)] over what these commits add. Added lines only:
    what a commit removes is not a leak, and binary files are read as text so a log counts."""
    log = subprocess.run(
        ["git", "-C", repo, "log", "--format=%x00%H%n%B%x00", "-p", "--text", "--no-color", "--no-ext-diff",
         "--no-renames", "-U0", *revisions],
        capture_output=True,
        check=True,
    ).stdout
    results = []
    path = None
    number = 0
    in_message = False
    for line in log.split(b"\n"):
        if in_message:
            if line.endswith(b"\0"):       # the closing marker: on its own line, or after the last byte
                in_message = False
                line = line[:-1]
            results.extend(("commit message", 0, kind) for kind in findings_in(line, live))
            continue
        if line.startswith(b"\0"):
            in_message = True
            path = None
            continue
        if line.startswith(b"+++ "):
            name = line[4:].decode(errors="replace")
            path = None if name == "/dev/null" else name[2:] if name.startswith("b/") else name
        elif line.startswith(b"@@ "):
            match = re.search(rb"\+(\d+)", line)
            number = int(match.group(1)) if match else 0
        elif line.startswith(b"+") and path and path != ALLOW_FILE and not is_allowed(path, patterns):
            results.extend((path, number, kind) for kind in findings_in(line[1:], live))
            number += 1
    return results


def report(repo_name, results):
    """Print a few per file, and how many there were. Returns how many."""
    if not results:
        print(f"ok    {repo_name}")
        return 0
    print(f"FOUND {repo_name}: {len(results)} match(es)")
    by_file = {}
    for path, number, kind in results:
        by_file.setdefault(path, []).append((number, kind))
    for path, hits in sorted(by_file.items()):
        kinds = sorted({kind for _, kind in hits})
        first = hits[0][0]
        where = f"{path}:{first}" if first else path
        print(f"      {where}  {', '.join(kinds)}  ({len(hits)})")
    return len(results)


def workspace_repos(root):
    """(name, path) of every plain repository workspace.repos declares."""
    repos = []
    with open(os.path.join(root, "workspace.repos"), encoding="utf-8") as listing:
        for line in listing:
            if line.startswith("#") or "|" not in line:
                continue
            name, path, _url, _branch, kind = line.strip().split("|")
            if kind == "repo":
                repos.append((name, os.path.join(os.path.dirname(root), path)))
    return repos


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", default=None, help="the repository (default: the one holding the working directory)")
    what = parser.add_mutually_exclusive_group()
    what.add_argument("--range", help="what the commits A..B add")
    what.add_argument("--tip", help="what the commits behind this tip add, that no remote has")
    what.add_argument("--all", action="store_true")
    what.add_argument("--workspace", action="store_true")
    parser.add_argument("--no-live", action="store_true", help="skip this household's own details")
    args = parser.parse_args()

    live = {} if args.no_live else read_live()
    if not args.no_live:
        names = sorted({re.sub(r" \d+$", "", name) for name in live})
        print("live details checked: " + (", ".join(names) or "none could be read"))

    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if args.workspace:
        total = 0
        for name, path in workspace_repos(root):
            total += report(name, scan_tree(path, live, allowed_paths(path)))
        return 1 if total else 0

    repo = args.repo or run("git", "rev-parse", "--show-toplevel") or "."
    name = os.path.basename(os.path.abspath(repo))
    patterns = allowed_paths(repo)
    if args.all:
        results = scan_tree(repo, live, patterns)
    else:
        revisions = [args.range] if args.range else [args.tip or "HEAD", "--not", "--remotes"]
        results = scan_commits(repo, revisions, live, patterns)
    found = report(name, results)
    if found:
        print(f"\nThese repositories are public. Mask each value, or, if it is meant to be there, add the\n"
              f"path to {ALLOW_FILE} with the reason (scripts/public-check --help).")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
