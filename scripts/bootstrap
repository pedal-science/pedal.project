#!/usr/bin/env bash
# scripts/bootstrap [--root DIR] [--source URL] [--branch NAME]: from nothing to a working
# checkout of the whole project. It needs only git and the network: no key, no account, nothing
# already on the machine. On an empty machine, either of:
#
#   curl -fsSL https://raw.githubusercontent.com/pedal-science/pedal.project/main/scripts/bootstrap | bash
#   git clone https://github.com/pedal-science/pedal.project.git /tmp/p && /tmp/p/scripts/bootstrap
#
# It makes the workspace (default ~/code.local/pedal), clones every repository workspace.repos
# declares that is missing, with their submodules, turns on the git guard, runs scripts/workspace
# check, and says which tools this machine still lacks. Running it again repairs what is missing
# and touches nothing that is there. docs/workspace.md, "Starting from nothing", is the design.
#
# --source clones pedal.project from elsewhere (a test, or a mirror), then points origin back at
# GitHub, so the checkout it leaves is the same as any other.
set -euo pipefail

CANONICAL=https://github.com/pedal-science/pedal.project.git
ROOT=$HOME/code.local/pedal
SOURCE=$CANONICAL
BRANCH=main
while [[ $# -gt 0 ]]; do
  case $1 in
    --root) ROOT=$2; shift ;;
    --source) SOURCE=$2; shift ;;
    --branch) BRANCH=$2; shift ;;
    -h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) printf 'bootstrap: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

say() { printf '\033[1m==\033[0m %s\n' "$*"; }
command -v git >/dev/null || { printf 'bootstrap: git is the one thing this needs, and it is missing\n' >&2; exit 1; }

mkdir -p "$ROOT"
ROOT=$(cd "$ROOT" && pwd -P)
PROJECT=$ROOT/pedal.project

if [[ -e $PROJECT/.git ]]; then
  say "pedal.project is already at $PROJECT"
else
  say "cloning pedal.project into $PROJECT"
  git clone --quiet --branch "$BRANCH" "$SOURCE" "$PROJECT"
  [[ $SOURCE == "$CANONICAL" ]] || git -C "$PROJECT" remote set-url origin "$CANONICAL"
fi

WORKSPACE=$PROJECT/scripts/workspace
say "the workspace's root files"
"$WORKSPACE" apply --root "$ROOT"
say "the other repositories"
"$WORKSPACE" clone --root "$ROOT"

# The guard (tools/git-hooks). At the usual place it follows the path, through ~/.gitconfig, so a
# new clone or worktree there has it with no step of its own. Anywhere else hooks.gitconfig's path
# would be wrong, so each repository is told directly.
say "the git guard"
HOOKS=$PROJECT/tools/git-hooks
if [[ $ROOT == "$(cd "$HOME" && pwd -P)/code.local/pedal" ]]; then
  key="includeIf.gitdir:~/code.local/pedal/.path"
  value="~/code.local/pedal/pedal.project/tools/git-hooks/hooks.gitconfig"
  if [[ $(git config --global --get "$key" 2>/dev/null || true) != "$value" ]]; then
    git config --global "$key" "$value"
    printf 'added to ~/.gitconfig: %s\n' "$key"
  fi
else
  while IFS='|' read -r _name path _url _branch kind; do
    [[ $kind == repo ]] && git -C "$ROOT/$path" config core.hooksPath "$HOOKS"
  done < <(grep -v '^#' "$PROJECT/workspace.repos")
fi

say "checking the result"
"$WORKSPACE" check --root "$ROOT"

say "tools on this machine"
missing=()
for tool in python3 cmake ninja gcc docker gh uv rsync; do
  command -v "$tool" >/dev/null || missing+=("$tool")
done
if (( ${#missing[@]} )); then
  printf 'not found: %s. docs/workspace.md says what needs which.\n' "${missing[*]}"
else
  printf 'all present\n'
fi

printf '\nReady. Open a session on %s, and start with pedal.project/AGENTS.md.\n' "$ROOT"
printf 'Pushing needs GitHub access: gh auth login, then gh auth setup-git.\n'
