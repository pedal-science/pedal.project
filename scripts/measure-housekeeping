#!/usr/bin/env bash
# scripts/measure-housekeeping [--host vip] [--seconds 240] [--mb 200] [--target 0.78]
#                             [--rig NAME] [--warm NAME] [--out DIR]
#                    — T5: does one housekeeping core carry everything else without moving a render?
#
# The rules (amended 2026-10-09) spend every core but one on rendering, so core 0 carries `pedald`,
# the engine's control side, WiFi, the SD card and the OS — and D5 keeps the audio interrupt *off*
# it, so the interrupt is not what this measures any more. What T5 asks is what that one core costs
# the cores that render.
#
# Two arms, the same rig playing and a warm document rendering on an inactive core in both:
#
#   arm A  quiet
#   arm B  loaded on core 0: a CPU spinner, SD *reads* (a read walk of the models, no bulk writes —
#          the card is the owner's), a compile burst (`cost` over the heaviest rig, repeated, which the
#          engine runs on the control thread pinned to core 0), and WiFi traffic shaped like the app's:
#          `GET /library/rigs` from the Mac over and over, which is ljoss reading the pedal's library
#
# Read for each arm:
#
#   * engine.status: the render tail (worst_us, worst_percent, over_deadline, histogram), xruns,
#     guard trips, and the cost of the rig being rendered
#   * engine.status.warm: the warm document's behind_blocks, worst_behind_blocks, blocks_dropped
#   * the IRQ thread's /proc/<tid>/schedstat: run_delay per wake — it shares core 1 with the warm
#     thread, so this is where the interrupt's cost shows if it shows anywhere
#   * per-core busy from /proc/stat, and the temperature
#
# The falsifier (the document's): a compile, an upload or a backup on core 0 moves the render cores'
# tail, or pushes the active rig over the deadline. The gate is 0 xruns and 0 blocks over the
# deadline in both arms; the *reading* is the delta between them, which this prints.
#
# The active rig is built for the test: a copy of the rig the pedal plays, with its chains repeated
# until `rig.cost` puts it just under the headroom (default 0.78), so the render core is as full as
# admission allows. Both test rigs are removed at the end, and the warm set is cooled.
#
# The load is a spinner, SD reads, a compile burst and the app's own read traffic; nothing is
# written in bulk (2026-10-09, the owner's SD card).
# The first T6 harness asked for 1.2 GB on a 2.9 GB card and filled it; not again.
#
# Measured 2026-10-09: bench-results/2026-10-09-housekeeping-vip/README.md.
set -u
CTL="/opt/namchain/current/bin/namchainctl --token-file /etc/namchain/token"
HOST=vip
RUN=240
TARGET=0.78
RIG=t5-heavy.json
WARM=""
WARM2=""
NOWARM=no
EXTRA=none
WIFI=ljoss
OUT=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --host) HOST=$2; shift ;;
    --seconds) RUN=$2; shift ;;
    --mb) shift ;;                 # kept so older command lines still parse; the load reads, not writes
    --target) TARGET=$2; shift ;;
    --rig) RIG=$2; shift ;;
    --warm) WARM=$2; shift ;;
    --no-warm) NOWARM=yes ;;
    --extra) EXTRA=$2; shift ;;    # renderer: a second renderer on warm_cpus[1], the second warm core
    --wifi) WIFI=$2; shift ;;      # ljoss: read the bank from here, as the app does; none
    --out) OUT=$2; shift ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    *) echo "measure-housekeeping: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT=${OUT:-$ROOT/build/$HOST/t5}
mkdir -p "$OUT"
# The report is the evidence, so it is kept as well as printed.
exec > >(tee "$OUT/t5.txt") 2>&1

ctl() { ssh "$HOST" "sudo -n $CTL $*"; }

# The engine's status, as one JSON object on stdout. Note `--compact status`, not `status --compact`:
# the flag is a global option of namchainctl.
status() { ssh "$HOST" "sudo -n $CTL --compact status"; }

# A block of lines describing one arm, parsed out of the status above.
describe() { # describe <label>
  status | python3 -c "
import json, sys
s = json.load(sys.stdin)['status']
r = s['render']
c = s.get('cost') or {}
print('    rig          %s  (cost %s, %s)' % (s.get('rig'), round(c.get('cost', 0), 3), c.get('verdict')))
print('    render       worst %.1f us = %.1f%%  over_deadline %d  over_90 %d' % (
    r['worst_us'], r['worst_percent'], r['over_deadline'], r['over_90_percent']))
print('    histogram    %s' % json.dumps(r['load_histogram']))
print('    xruns %d  guard_trips %d  blocks %d' % (s['xruns'], s['guard_trips'], s['blocks']))
w = s.get('warm') or {}
for e in w.get('set') or []:
    if not e.get('audible'):
        print('    warm         %s on core %s: state %s, behind %s (worst %s), dropped %s, blocks %s' % (
            e.get('rig'), e.get('core'), e.get('state'), e.get('behind_blocks'),
            e.get('worst_behind_blocks'), e.get('blocks_dropped'), e.get('blocks')))
if not w:
    print('    warm         none (this device has no warm set)')
"
}

# The IRQ thread's wait to run, and its wake count, as raw schedstat numbers.
irq_stat() { ssh "$HOST" 't=$(pgrep -f "irq/138-dw_axi" | head -1); cat /proc/$t/schedstat'; }

# Per-core busy over a window. Two samples of "cpu busy total" ticks, so the percentage is a
# percentage and not a tick count: `100 * (busy2 - busy1) / (total2 - total1)`.
cpu_stat() { ssh "$HOST" 'awk "/^cpu[0-9]/{u=\$2+\$3+\$4+\$7+\$8+\$9; i=\$5; print \$1, u, u+i}" /proc/stat'; }
temp_c() { ssh "$HOST" 'awk "{printf \"%.1f\", \$1/1000}" /sys/class/thermal/thermal_zone0/temp'; }

# The clock and the firmware's low-voltage flag, which are what T11 is about: an hour at full load is
# only a fair measurement if the cores kept their frequency and the rail did not sag.
clock_mhz() { ssh "$HOST" 'awk "{printf \"%d\", \$1/1000}" /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null'; }
volt_alarm() { ssh "$HOST" 'cat /sys/class/hwmon/hwmon*/in0_lcrit_alarm 2>/dev/null | head -1'; }

busy_delta() { # busy_delta <before> <after>
  python3 - "$1" "$2" <<'EOF'
import sys
def parse(t):
    out = {}
    for line in t.strip().splitlines():
        name, busy, total = line.split()
        out[name] = (int(busy), int(total))
    return out
a, b = parse(sys.argv[1]), parse(sys.argv[2])
parts = []
for c in sorted(a):
    dbusy, dtotal = b[c][0] - a[c][0], b[c][1] - a[c][1]
    parts.append("%s %.1f%%" % (c, 100.0 * dbusy / dtotal if dtotal else 0.0))
print("    per-core busy over the arm: " + "  ".join(parts))
EOF
}

# ------------------------------------------------------------------ set up the rigs

echo "T5: what one housekeeping core costs the render cores."
echo "host $HOST, $RUN s an arm, load: spinner + SD reads + compile burst + app traffic ($WIFI), target cost $TARGET"
echo

PLAYING=$(status | python3 -c "import json,sys; print(json.load(sys.stdin)['status'].get('rig') or '')")
TOKEN=$(ssh "$HOST" "sudo cat /etc/namchain/token" 2>/dev/null | tr -d '\n')
[[ -n $TOKEN ]] || { echo "could not read the engine's token on $HOST" >&2; exit 1; }
# The bench's input: copied once into /var/tmp/t5 and reused, because it is 8 MB and the point of the
# WiFi leg is the app's traffic, not this file.
# Two homes: /var/tmp for this harness's own bench runs, and /var/lib/pedal for `pedal-measure`,
# which measures a first-sight row later and must use the same signal the table was measured with
# (the table now names it, hash and all). One copy, both places, and only when it is missing.
ssh "$HOST" "sudo mkdir -p /var/tmp/t5 && sudo test -s /var/tmp/t5/guitar-di.wav && sudo test -s /var/lib/pedal/guitar-di.wav" 2>/dev/null \
  || { echo "    copying the DI to $HOST once (8 MB, into /var/tmp/t5 and /var/lib/pedal)"; scp -q guitar-di.wav "$HOST:/var/tmp/t5-di.wav" && ssh "$HOST" "sudo mkdir -p /var/tmp/t5 && sudo mv /var/tmp/t5-di.wav /var/tmp/t5/guitar-di.wav && sudo install -m 644 /var/tmp/t5/guitar-di.wav /var/lib/pedal/guitar-di.wav"; }

echo "== setup"

# A fresh engine: the counters (`xruns`, `over_deadline`, the histogram) are cumulative since
# namchaind started, so an arm's numbers are only readable from zero. It also drops whatever warm set
# was held, which is what --no-warm wants and what the warm case then builds for itself.
echo "    restarting namchaind for fresh counters"
ssh "$HOST" "sudo systemctl restart namchaind" || { echo "could not restart namchaind" >&2; exit 1; }
sleep 6
PLAYING=$(status | python3 -c "import json,sys; print(json.load(sys.stdin)['status'].get('rig') or '')")
[[ -n $PLAYING ]] || { echo "nothing is playing after the restart; start the engine with a rig first" >&2; exit 2; }
PLAY_NAME=$(basename "$PLAYING")
echo "    playing      $PLAYING"
[[ -n $WARM ]] || WARM=t5-warm.json
[[ -n $WARM2 ]] || WARM2=t5-warm2.json

# The pedal's resume state: pedald writes the document being played into the rigs root as `last.json`
# (and the one before it as `last.prev.json`), so loading a test rig overwrites both. They are backed
# up here and put back at the end -- without this a measurement leaves the pedal playing the test rig,
# which is exactly what happened on 2026-10-09 (recovered from the T10 harness's own rig copies).
ssh "$HOST" "rm -rf /var/tmp/t5-resume && mkdir -p /var/tmp/t5-resume && cp /var/lib/pedal/library/rigs/last.json /var/lib/pedal/library/rigs/last.prev.json /var/tmp/t5-resume/ 2>/dev/null; ls /var/tmp/t5-resume"

# Two test rigs, both built from the document the pedal is playing:
#
#   $RIG    the active rig: its chains repeated, with fresh ids, until `cost` says it is just under
#           the headroom. Duplicating a chain means renaming it and every node and connection in it,
#           because ids are the document's namespace and the engine refuses a duplicate. The document
#           cap is `kMaxChains = 8`, so that is the ceiling however heavy the target is.
#   $WARM   the neighbour: the playing document unchanged, so the warm thread renders real work on an
#           inactive core and pedald has a second rig for its bank.
#
# Written into the rigs root because `rig.cost` and `rig.load` resolve a rig by name there.
ssh "$HOST" "sudo python3 - '$PLAY_NAME' '$RIG' '$WARM' '$WARM2' '$TARGET' '$CTL'" <<'EOF'
import copy, json, os, subprocess, sys
playing, heavy, warm, warm2 = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
target, ctl = float(sys.argv[5]), sys.argv[6].split()
root = "/var/lib/pedal/library/rigs"
MAX_CHAINS = 8          # daemon.h: a document may hold at most this many
doc = json.load(open(os.path.join(root, playing)))
base = list(doc.get("chains") or [])
if not base:
    sys.exit("the playing rig has no chains")

def place(path, body):
    tmp = "/tmp/" + os.path.basename(path)
    json.dump(body, open(tmp, "w"), indent=1)
    subprocess.run(["sudo", "-n", "install", "-m", "644", "-o", "pedal", "-g", "pedal", tmp, path],
                   check=True)

def cost(name):
    out = subprocess.run(["sudo", "-n", *ctl, "cost", name, "--compact"], capture_output=True, text=True)
    try:
        reply = json.loads(out.stdout)
    except Exception:
        return None, (out.stdout or out.stderr).strip()[:200]
    if not reply.get("ok"):
        return None, (reply.get("error") or {}).get("message", "refused")
    return (reply.get("cost") or {}).get("cost"), None

def clone(chain, k):
    c = copy.deepcopy(chain)
    c["id"] = "%s-c%d" % (chain.get("id", "chain"), k)
    for n in c.get("nodes") or []:
        if n.get("id"):
            n["id"] = "%s-c%d" % (n["id"], k)
        if n.get("element"):
            n["element"] = "%s-c%d" % (n["element"], k)
    for conn in c.get("connections") or []:
        for key in ("from", "to"):
            if isinstance(conn.get(key), str):
                conn[key] = "%s-c%d" % (conn[key], k)
    return c

# The neighbours first: they are the playing document as it stands. One is the engine's warm
# document; the other is what the second renderer (the stand-in for a second warm core) renders.
for path, name in ((warm, warm[:-5]), (warm2, warm2[:-5])):
    neighbour = copy.deepcopy(doc)
    neighbour["name"] = name
    place(os.path.join(root, path), neighbour)

def build(n):
    heavy_doc = copy.deepcopy(doc)
    heavy_doc["name"] = heavy[:-5]
    heavy_doc["chains"] = [clone(base[i % len(base)], i) for i in range(n)]
    place(os.path.join(root, heavy), heavy_doc)

best = None
for n in range(len(base), MAX_CHAINS + 1):
    build(n)
    c, err = cost(heavy)
    print("    candidate    %d chains -> cost %s%s" % (n, c, " (%s)" % err if err else ""))
    if c is None:
        sys.exit("rig.cost would not cost the candidate rig: %s" % err)
    if c < target:
        best = (n, c)
    else:
        break
if best is None:
    sys.exit("even %d chains cost %s, at or over the %s target: play a lighter rig or raise --target"
             % (len(base), cost(heavy)[0], target))
build(best[0])
print("    active rig   %d chains, cost %s" % best)
EOF
[[ $? == 0 ]] || { echo "the setup failed; nothing was measured" >&2; exit 1; }
# The rigs are evidence as well as input: keep them beside the report, as the soak harness does.
mkdir -p "$OUT/rigs"
for f in "$RIG" "$WARM"; do
  scp -q "$HOST:/var/lib/pedal/library/rigs/$f" "$OUT/rigs/$f" || true
done

# pedald's bank is the library's rigs, read once at startup, and its warm set is the rig one press
# away. Restarting it is what makes it see the two test rigs -- and its own warming is the realistic
# arrangement, so the arms run with pedald's choice warm rather than one this script imposed. With
# --no-warm the bank is left empty on purpose: pedald then cools whatever was warm, which is how the
# coexistence cost of a warm document is separated from the cost of the audible rig alone.
if [[ $NOWARM == yes ]]; then
  echo "    --no-warm: pedald is stopped so nothing is held warm"
  ssh "$HOST" "sudo systemctl stop pedald" || true
  sleep 2
  ctl "cool" >/dev/null 2>&1 || true
else
  echo "    restarting pedald so its bank includes the test rigs"
  ssh "$HOST" "sudo systemctl restart pedald" || true
fi

echo "    making the active rig audible"
load_reply=$(ctl "load '$RIG' --compact" 2>&1)
case "$load_reply" in
  *'"ok":true'*) ;;
  *) echo "could not load $RIG as the audible rig: $load_reply" >&2; exit 1 ;;
esac

# Wait for the warm side to be a document that is not the audible one and has rendered a block, and
# say so plainly when it never happens: an arm with no warm work measures less than it claims.
# 90 s, not 20: pedald polls its status on a timer and only then asks for a warm, so a fresh restart
# can take tens of seconds to have a document rendering -- and the 2026-10-10 T11 run started with no
# warm document at all because this loop gave up first (the arm then measured without it).
warm_ready=no
for _ in $(seq 1 90); do
  n=$(status | python3 -c "
import json,sys
s = json.load(sys.stdin)['status']
print(sum(1 for e in ((s.get('warm') or {}).get('set') or [])
          if not e.get('audible') and e.get('state') == 'warm' and (e.get('blocks') or 0) > 0))
" 2>/dev/null || echo 0)
  [[ $n -ge 1 ]] && { warm_ready=yes; break; }
  sleep 1
done
[[ $warm_ready == yes ]] || echo "    WARNING: no warm document is rendering; the arms measure the" \
                               "render cores without warm work beside them"
describe setup

# The second warm core. The engine holds *one* warm document (kMaxDocuments is 2: the audible one and
# one warm), so warming two rigs -- one per inactive core, which is what D4 says ships for a pedal with
# two footswitch neighbours -- cannot be measured through the daemon yet. What can be measured is the
# question underneath it: what a *second* renderer on the other warm core (2) costs the audible one
# through the same shared L3 and DRAM. The bench's `rig` mode is the stand-in -- a real model and cab
# off the same library, at the priority the warm thread runs at, pinned to core 2 -- and the report
# says so rather than pretending the daemon did it.
if [[ $EXTRA == renderer ]]; then
  echo "    second renderer on core 2: $WARM2 (the bench's rig mode, priority 70)"
  ssh "$HOST" "sudo -n systemd-run --quiet --unit=t5-extra --slice=pedal-bench.slice --collect /opt/namchain/current/bin/namchain-warm-bench rig --input /var/tmp/t5/guitar-di.wav --document /var/lib/pedal/library/rigs/$WARM2 --seconds $((RUN * 2 + 180)) --cpu 2 --priority 70 > /var/tmp/t5-extra.log 2>&1" || true
  ssh "$HOST" "sleep 2; tail -2 /var/tmp/t5-extra.log; pgrep -a -f 'namchain-warm-bench rig' | head -1"
fi
echo

# ------------------------------------------------------------------ the arms

# The load on the housekeeping core, and what is *not* in it:
#
#   * a CPU spinner (another process wanting the core);
#   * SD *reads* -- a loop of `dd if=<model> of=/dev/null` over the library's models, which is what the
#     engine itself does when it compiles a rig. There is deliberately no bulk write: the card is the
#     pedal's, a measurement is not worth wearing it out, and a write loop is not something the pedal
#     does while playing either (2026-10-09, the owner);
#   * a compile burst: `cost` over the active rig, repeated, which the engine runs on the control
#     thread pinned to core 0 -- the heaviest thing core 0 does;
#   * and WiFi traffic shaped like the app's: from the Mac, `GET /library/rigs` and a rig document over
#     and over, which is ljoss reading the pedal's library. The *upload* direction -- ljoss sending a
#     model or a rig -- goes through pedald's routes; the model and IR routes are specced but not
#     implemented yet (a `PUT /library/models/<file>` answers 404 today), so the leg that is exercised
#     here is the read side, and an upload that *does* land is measured separately rather than mixed
#     into an arm (it changes the bank, and the bank is what decides what is warm).
arm() { # arm <label> <load: yes|no>
  local label=$1 load=$2
  echo
  echo "== arm $label"
  local cpu0 irq0 tmp0
  cpu0=$(cpu_stat); irq0=$(irq_stat); tmp0=$(temp_c)
  describe before

  local dd scp_pid wifi_pid
  rm -f /tmp/t5-stop
  if [[ $load == yes ]]; then
    # The compile burst, pinned to core 0 like any other control-side work.
    ssh "$HOST" "taskset -c 0 timeout $RUN bash -c 'while :; do sudo -n $CTL cost $RIG >/dev/null; done' >/dev/null 2>&1 & echo \$! > /var/tmp/t5-burst.pid" || true
    # Reads, not writes: the spinner and a read walk of the models.
    ssh "$HOST" "taskset -c 0 yes > /dev/null 2>&1 & echo \$! > /var/tmp/t5-yes.pid; taskset -c 0 timeout $RUN bash -c 'while :; do for f in /var/lib/pedal/library/models/*/*.nam; do dd if=\"\$f\" of=/dev/null bs=1M 2>/dev/null || true; done; done' >/dev/null 2>&1 & echo \$! > /var/tmp/t5-read.pid" || true
    dd=""
    # The app's traffic: read the bank's listing and one document, over and over, from here.
    if [[ $WIFI == ljoss ]]; then
      ( n=0; while [[ ! -f /tmp/t5-stop ]]; do
          curl -sS -o /dev/null -m 10 -H "Authorization: Bearer $TOKEN" "http://$HOST:47820/library/rigs" && n=$((n+1))
          curl -sS -o /dev/null -m 10 -H "Authorization: Bearer $TOKEN" "http://$HOST:47820/library/rigs/$PLAY_NAME" && n=$((n+1))
          echo "$n" > /tmp/t5-wifi-count
        done ) &
      wifi_pid=$!
      rm -f /tmp/t5-wifi-count
    fi
  fi
  sleep "$RUN"
  if [[ $load == yes ]]; then
    touch /tmp/t5-stop
    kill ${wifi_pid:-0} 2>/dev/null || true
    wait ${wifi_pid:-0} 2>/dev/null || true
    ssh "$HOST" 'for f in /var/tmp/t5-yes.pid /var/tmp/t5-burst.pid /var/tmp/t5-read.pid; do [ -f $f ] && kill "$(cat $f)" 2>/dev/null; rm -f $f; done; pkill -f "dd if=" 2>/dev/null; true' || true
  fi

  describe after
  [[ -f /tmp/t5-wifi-count ]] && echo "    app traffic  $(cat /tmp/t5-wifi-count) library requests over WiFi during the arm"
  busy_delta "$cpu0" "$(cpu_stat)"
  python3 - "$irq0" "$(irq_stat)" "$tmp0" "$(temp_c)" <<'EOF'
import sys
def nums(line):
    return [int(x) for x in line.split()[:3]]
a, b = nums(sys.argv[1]), nums(sys.argv[2])
dw, dd = b[1] - a[1], b[2] - a[2]
print("    irq thread   %d ns of wait to run over %d wakes = %.1f ns/wake" % (dw, dd, dw / dd if dd else 0))
print("    temperature  %s C -> %s C" % (sys.argv[3], sys.argv[4]))
EOF
  echo "    clock        $(clock_mhz) MHz now, low-voltage alarm $(volt_alarm)"
}

WHAT="spinner, SD reads, the app's traffic, compile burst"
[[ $EXTRA == renderer ]] && WHAT="$WHAT; second renderer on core 2"
arm "A: quiet (nothing on core 0)" no
arm "B: loaded ($WHAT)" yes

# ------------------------------------------------------------------ what it says

echo
echo "== reading"
status | python3 -c "
import json, sys
s = json.load(sys.stdin)['status']
r = s['render']
ok = s['xruns'] == 0 and r['over_deadline'] == 0 and s['guard_trips'] == 0
print('    final: xruns %d, blocks over the deadline %d, guard trips %d, worst block %.1f us (%.1f%%)' % (
    s['xruns'], r['over_deadline'], s['guard_trips'], r['worst_us'], r['worst_percent']))
print('    gate: %s' % ('PASS (both arms ended with 0 xruns and 0 blocks over the deadline)' if ok
                        else 'FAIL (see the arms above)'))
"
echo "    the decision this feeds: whether one housekeeping core carries pedald, the control side,"
echo "    WiFi, the SD card and a compile without moving the render cores' tail."

# ------------------------------------------------------------------ leave nothing behind

echo
echo "== cleanup"
# Put the pedal back the way it was found: pedald's resume files, the rig it was playing, its library
# without the test rigs, pedald restarted so its bank forgets them, and the warm set cooled.
ssh "$HOST" "sudo cp /var/tmp/t5-resume/last.json /var/lib/pedal/library/rigs/last.json 2>/dev/null; sudo cp /var/tmp/t5-resume/last.prev.json /var/lib/pedal/library/rigs/last.prev.json 2>/dev/null; sudo chown pedal:pedal /var/lib/pedal/library/rigs/last.json /var/lib/pedal/library/rigs/last.prev.json 2>/dev/null; true" || true
ctl "cool" >/dev/null 2>&1 || true
ssh "$HOST" "sudo systemctl stop t5-extra 2>/dev/null; sudo rm -f /var/lib/pedal/library/rigs/$RIG /var/lib/pedal/library/rigs/$WARM /var/lib/pedal/library/rigs/$WARM2; rm -rf /var/tmp/t5-resume; pkill -f 'dd if=' 2>/dev/null; true" || true
restore=$(ctl "load last.json --compact" 2>&1)
case "$restore" in
  *'"ok":true'*) echo "    restored last.json and its resume files" ;;
  *) echo "    WARNING: could not reload last.json: $restore" >&2 ;;
esac
ssh "$HOST" "sudo systemctl restart pedald" >/dev/null 2>&1 || true
rm -f /tmp/t5-stop
echo "    removed the test rigs ($RIG, $WARM ${WARM2}), stopped the second renderer, restarted pedald, cooled the warm set"
echo "    df: $(ssh "$HOST" 'df -h / | tail -1')"
echo "    still running on the host: $(ssh "$HOST" 'pgrep -a -f "t5-|rig.cost|yes$" | grep -v pgrep | head -3')"
