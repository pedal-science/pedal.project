#!/usr/bin/env bash
# scripts/deploy-engine [--host vip] [--commit <rev>] [--no-tests] — build namchain from a commit
# and install it on a Core host.
#
# vip has no compiler, so for vip it's built on the Mac, in the image build's container
# (devices/common/image/build-namchain, on the snapshot in devices/vip/image.lock and with the flags
# in devices/vip/image.env): exactly as the engine on vip's card was built. piv builds it itself, in
# a dedicated tree (~/pedal-build/namchain), never the dev checkout. pro (x86-64) builds it itself
# too, from the commit's exported tree sent from the Mac (so the commit needn't be pushed), clean each
# time, with the flags in devices/pro/build.env, and won't build while namchaind is running. Either way the tests run, then
# it's installed into /opt/namchain/<commit>/, /opt/namchain/current swapped to it, namchain's own
# unit installed (packaging/systemd/namchaind.service; devices/common adds the pedal's drop-in), a
# TCP token made if there's none (normally it's installed from 1Password: docs/vip-image.md),
# namchaind restarted, and devices/<host>/components.lock updated. It holds the host's lock
# throughout (scripts/host-lock).
set -euo pipefail

ARGS=("$@")
HOST=vip
REV=origin/main
TESTS=1
while [[ $# -gt 0 ]]; do
  case $1 in
    --host) HOST=$2; shift ;;
    --commit) REV=$2; shift ;;
    --no-tests) TESTS=0 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[[ $HOST == piv || $HOST == vip || $HOST == pro ]] || { echo "deploy-engine: piv, vip or pro" >&2; exit 2; }
[[ ${PEDAL_HOST_LOCK:-} == "$HOST" ]] || exec "$(dirname "$0")/host-lock" --host "$HOST" -- "$0" "${ARGS[@]}"

REPO=$(cd "$(dirname "$0")/.." && pwd)
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST")
log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

busy=$("${SSH[@]}" "pgrep -a -f 'namchain-soak|stress-ng|cyclictest' | grep -v pgrep" || true)
[[ -z $busy ]] || die "$HOST is busy:"$'\n'"$busy"

# On the host: install a staged engine (bin/, packaging/, MANIFEST in the directory given), swap
# current to it, and restart namchaind.
INSTALL=$(cat <<'EOF'
set -euo pipefail
stage=$1 commit=$2
dest=/opt/namchain/$commit
sudo install -d "$dest/bin" "$dest/packaging"
for b in "$stage"/bin/*; do sudo install -m 0755 "$b" "$dest/bin/"; done
sudo install -m 0644 "$stage/packaging/namchaind.service" "$dest/packaging/"
sudo install -m 0644 "$stage/MANIFEST" "$dest/MANIFEST"
sudo ln -sfn "$dest" /opt/namchain/current
sudo install -m 0644 "$dest/packaging/namchaind.service" /etc/systemd/system/namchaind.service
# Start the service only where the pedal's configuration is in place (its config, and the drop-in
# that points the unit at /opt/namchain/current): a host without them, like pro until devices/pro
# exists, gets the binaries and nothing else changed.
if [[ -s /etc/namchain/namchaind.json && -e /etc/systemd/system/namchaind.service.d/10-pedal.conf ]]; then
  if ! sudo test -s /etc/namchain/token; then
    sudo install -d -m 0755 /etc/namchain
    (umask 077; od -An -tx1 -N32 /dev/urandom | tr -d ' \n' | sudo tee /etc/namchain/token >/dev/null)
    sudo chmod 0600 /etc/namchain/token
    echo "made a new TCP token in /etc/namchain/token" >&2
  fi
  sudo systemctl daemon-reload
  sudo systemctl enable -q namchaind.service
  sudo systemctl restart namchaind.service
  sleep 3
  systemctl is-active namchaind.service
  # The first 600 characters of the status, read whole first: `| head -c 600` closed the pipe on a
  # long status, and under pipefail that SIGPIPE ended the deploy before components-lock ran.
  status=$(sudo -n /opt/namchain/current/bin/namchainctl --compact status 2>&1) || true
  printf '%s\n' "${status:0:600}"
else
  sudo systemctl daemon-reload
  echo "no pedal configuration for namchaind on this host: binaries installed, service left alone" >&2
fi
echo "installed $commit"
EOF
)
BINS=(namchaind namchainctl namchain-soak namchain-latency namchain-render namchain-warm-bench)

if [[ $HOST == piv ]]; then
  log "building $REV on $HOST"
  "${SSH[@]}" "mkdir -p ~/pedal-build && cat > ~/pedal-build/install.sh" <<<"$INSTALL"
  # ssh joins its arguments into one string for the remote shell, which splits it again: quote them
  # for it, or the list of binaries arrives as its first name only.
  "${SSH[@]}" "bash -s -- $(printf '%q ' "$REV" "$TESTS" "${BINS[*]}")" <<'REMOTE'
set -euo pipefail
rev=$1 tests=$2 bins=$3
cd ~/pedal-build
[[ -d namchain ]] || git clone -q git@github.com:pedal-science/namchain.git
cd namchain
git config url."git@github.com:".insteadOf https://github.com/
git fetch -q origin
git checkout -q --detach "$rev"
git submodule sync -q --recursive
git submodule update -q --init --recursive
commit=$(git rev-parse --short=7 HEAD)
cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_CXX_FLAGS=-march=armv8-a -mtune=cortex-a76" \
  -DNAMCHAIN_BUILD_TESTS=ON -DNAMCHAIN_BUILD_TOOLS=ON > build-configure.log
# namchain's summary line was "A2 planar NEON:  ON" until 0c1a6d8 (2026-11-03) and is "A2 planar:  ON (NEON)"
# or "(AVX2)" since: either says the planar kernels are compiled in.
grep -qE 'A2 planar NEON: +ON|A2 planar: +ON' build-configure.log || { echo "planar kernels are off" >&2; exit 1; }
nice cmake --build build -j2 > build.log || { tail -30 build.log >&2; exit 1; }
# Serially: under -j2 one timing test fails from contention, not from a defect.
[[ $tests == 1 ]] && (cd build && nice ctest --output-on-failure | tail -3)
stage=~/pedal-build/stage
rm -rf "$stage"; mkdir -p "$stage/bin" "$stage/packaging"
for b in $bins; do cp "build/$b" "$stage/bin/"; done
cp packaging/systemd/namchaind.service "$stage/packaging/"
# `rev` is the commit that was built, resolved: `--commit HEAD` is a reasonable thing to type and a
# useless thing to record. What reads this is the cost table's provenance check
# (`devices/common/check` compares cost.json's engine_commit with it), so a manifest saying "HEAD"
# fails a check that should pass and hides which engine a table was measured against.
printf 'commit=%s\nrev=%s\nbuilt=%s\nhost=%s\nkernel=%s\n' "$commit" "$commit" \
  "$(date -u +%FT%TZ)" "$(hostname)" "$(uname -r)" > "$stage/MANIFEST"
bash ~/pedal-build/install.sh "$stage" "$commit"
REMOTE
elif [[ $HOST == pro ]]; then
  NC=${NAMCHAIN_REPO:-$("$REPO/scripts/workspace" root --repo namchain)}
  # shellcheck disable=SC1091
  source "$REPO/devices/$HOST/build.env"
  git -C "$NC" fetch -q origin
  full=$(git -C "$NC" rev-parse --verify "$REV^{commit}") || die "no commit $REV in $NC"
  commit=${full:0:7}
  playing=$("${SSH[@]}" "systemctl is-active namchaind.service" || true)
  [[ $playing != active ]] || die "namchaind is running on $HOST: no builds while it plays (rule 8). Stop it first."
  # shellcheck disable=SC1091
  source "$REPO/devices/common/image/export.sh"
  W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
  log "exporting $REV ($commit) and building it on $HOST ($NAMCHAIN_CXXFLAGS)"
  export_tree "$NC" "$full" "$W/src"
  # Not /tmp: that is a RAM disk on the Core hosts. ~/pedal-build is on the root volume.
  "${SSH[@]}" "rm -rf ~/pedal-build/src ~/pedal-build/build && mkdir -p ~/pedal-build/src"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$W/src" -czf - . | "${SSH[@]}" "tar -xzf - -C ~/pedal-build/src"
  # ssh joins its arguments into one string for the remote shell, so quote them for it: the flags
  # and the binaries' names are each several words.
  "${SSH[@]}" "bash -s -- $(printf '%q ' "$commit" "$TESTS" "$NAMCHAIN_CXXFLAGS" "${BINS[*]}")" <<'REMOTE'
set -euo pipefail
commit=$1 tests=$2 flags=$3 bins=$4
cd ~/pedal-build/src
cmake -S . -B ../build -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_CXX_FLAGS=$flags" \
  -DNAMCHAIN_BUILD_TESTS=ON -DNAMCHAIN_BUILD_TOOLS=ON > ../build-configure.log
nice -n 19 cmake --build ../build -j4 > ../build.log || { tail -30 ../build.log >&2; exit 1; }
# Serially, as on piv: timing tests fail from contention under parallelism, not from a defect.
[[ $tests == 1 ]] && (cd ../build && nice -n 19 ctest --output-on-failure | tail -3)
stage=~/pedal-build/stage
rm -rf "$stage"; mkdir -p "$stage/bin" "$stage/packaging"
for b in $bins; do cp "../build/$b" "$stage/bin/"; done
cp packaging/systemd/namchaind.service "$stage/packaging/"
printf 'commit=%s\nrev=%s\nbuilt=%s\nhost=%s\nkernel=%s\nflags=%s\n' "$commit" "$commit" \
  "$(date -u +%FT%TZ)" "$(hostname)" "$(uname -r)" "$flags" > "$stage/MANIFEST"
REMOTE
  "${SSH[@]}" "bash -s -- \"\$HOME/pedal-build/stage\" $commit" <<<"$INSTALL"
else
  NC=${NAMCHAIN_REPO:-$("$REPO/scripts/workspace" root --repo namchain)}
  # shellcheck disable=SC1091
  source "$REPO/devices/$HOST/image.env"
  SNAPSHOT=$(sed -n 's/^snapshot=//p' "$REPO/devices/$HOST/image.lock")
  git -C "$NC" fetch -q origin
  full=$(git -C "$NC" rev-parse --verify "$REV^{commit}") || die "no commit $REV in $NC"
  commit=${full:0:7}
  docker info >/dev/null 2>&1 || die "no docker: start colima (colima start --arch aarch64 --vm-type vz)"
  W=$REPO/build/engine/$commit
  rm -rf "$W"; mkdir -p "$W"
  # shellcheck disable=SC1091
  source "$REPO/devices/common/image/export.sh"
  log "building $REV ($commit) for $HOST on the Mac (snapshot $SNAPSHOT, $NAMCHAIN_CXXFLAGS)"
  export_tree "$NC" "$full" "$W/src"
  TAG=pedal-build:$SNAPSHOT
  docker build -q -t "$TAG" --build-arg SNAPSHOT="$SNAPSHOT" "$REPO/devices/common/image" >/dev/null
  # Built inside the container's own filesystem: the Mac's shared directory can't chmod a Unix
  # socket, and the ctl_cli test makes one. Only the binaries come back out.
  docker run --rm -v "$W:/w" -v "$REPO/devices/common/image:/img:ro" "$TAG" bash -c '
    set -e; cp -a /w/src /build-src
    /img/build-namchain /build-src "$1" /w/logs $2
    mkdir -p /w/bin; for b in $3; do cp /build-src/build/$b /w/bin/; done' _ \
    "$NAMCHAIN_CXXFLAGS" "$( ((TESTS)) || echo --no-tests)" "${BINS[*]}"
  mkdir -p "$W/stage/bin" "$W/stage/packaging"
  cp "$W"/bin/* "$W/stage/bin/"
  cp "$W/src/packaging/systemd/namchaind.service" "$W/stage/packaging/"
  printf 'commit=%s\nrev=%s\nbuilt=%s\nhost=%s\nkernel=%s\n' "${full:0:7}" "${full:0:7}" "$(date -u +%FT%TZ)" \
    "build container on $(hostname -s) (resolute $SNAPSHOT)" "$("${SSH[@]}" uname -r)" > "$W/stage/MANIFEST"
  log "installing on $HOST"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$W/stage" -czf - . | "${SSH[@]}" "rm -rf /tmp/namchain-stage && mkdir /tmp/namchain-stage && tar -xzf - -C /tmp/namchain-stage"
  "${SSH[@]}" bash -s -- /tmp/namchain-stage "$commit" <<<"$INSTALL"
  "${SSH[@]}" "rm -rf /tmp/namchain-stage"
  rm -rf "$W/src"
fi
"$(dirname "$0")/components-lock" --host "$HOST"
