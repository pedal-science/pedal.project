#!/usr/bin/env bash
# scripts/plan-graph — write docs/diagrams/plan-dependency-graph.svg from the HTML beside it.
#
# The HTML is the one home for the plan's nodes and edges: its script lays the SVG out at load
# time so a browser can draw it. This runs that same script without a browser and writes a static
# SVG, which reads as text (and previews) anywhere. Edit the HTML, run this, commit both.
#
# The static SVG carries the light palette as **literal colours**, not the HTML's CSS variables:
# a file viewer or a rasteriser is not a browser, and librsvg (rsvg-convert) draws `var(--x)` as
# no paint at all, which is a blank or black picture. The HTML keeps the variables and the dark
# theme for the browser; this copy is flat on purpose.
#
# No raster copy is kept beside it: the SVG is the picture, and because it carries literal
# colours, every viewer draws it — not only a browser.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
node - "$root/docs/diagrams/plan-dependency-graph.html" "$root/docs/diagrams/plan-dependency-graph.svg" <<'JS'
const fs = require('fs');
const [htmlPath, svgPath] = process.argv.slice(2);
const html = fs.readFileSync(htmlPath, 'utf8');

const script = html.match(/<script>([\s\S]*?)<\/script>/);
if (!script) { console.error('plan-graph: no <script> in ' + htmlPath); process.exit(1); }
const updated = (html.match(/Updated ([^<.]+) from/) || [])[1] || '';

const el = { setAttribute() {}, innerHTML: '' };
const { N, E, SW, SH } = new Function('document', script[1] + '\n;return {N,E,SW,SH};')({
  getElementById: () => el,
});

// The HTML's :root block, light theme. Keep the two in step: the HTML is the design, and this is
// what everything that cannot read a CSS variable has to be given.
const LIGHT = {
  bg: '#f6f4ef', ink: '#1d1d1f', muted: '#5b5b60', line: '#6b6b73',
  done: '#1f8a4c', doneFill: '#dff3e6', next: '#d9591a', nextFill: '#ffe7d6',
  todo: '#3a3a42', todoFill: '#ffffff', mile: '#1b3fa0', mileFill: '#dfe7ff',
  lane: '#00000008', laneInk: '#00000055',
};

const nodes = Object.keys(N).length;
// The fragment is HTML, where a bare "&" is fine; in XML it must be escaped. The fragment carries
// no entities of its own, so every "&" is a label's.
const body = el.innerHTML
  .replace(/var\(--([A-Za-z]+)\)/g, (whole, name) => LIGHT[name] || whole)
  .replace(/&/g, '&amp;');
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${SW}" height="${SH}" viewBox="0 0 ${SW} ${SH}">
<title>Pedal plan — dependency graph</title>
<desc>${nodes} nodes, ${E.length} edges. Updated ${updated} from plan.md and the docs it names.
Green = done, orange = next up, white = to do, blue = milestone/goal. Left to right is dependency
order. Generated by scripts/plan-graph from plan-dependency-graph.html, which holds the data.
Colours are the light theme written literally, so any viewer or rasteriser can draw this.</desc>
<style>
text{font-family:system-ui,-apple-system,sans-serif}
</style>
<rect width="${SW}" height="${SH}" fill="${LIGHT.bg}"/>
${body}
</svg>
`;
fs.writeFileSync(svgPath, svg);
console.log(`plan-graph: ${svgPath} — ${nodes} nodes, ${E.length} edges, ${SW}×${SH}`);
JS
