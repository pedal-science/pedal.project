#!/usr/bin/env bash
# scripts/measure-irq [--host vip] [--seconds 240] [--mb 200] [--out DIR]
#                    — T6: which core the audio IRQ belongs on (D5, amended 2026-10-09)
#
# D5 now says: a render core, but never the *active* one. The interrupt preempts whatever it lands
# on (SCHED_FIFO 85, above the render thread's 80), so on the active core that is a missed deadline
# and on an inactive one it is a warm rig falling a block behind. Each arm puts the same load on the
# housekeeping core -- a CPU spinner on core 0, a bounded SD write and a bounded WiFi upload --
# plays the same amp-and-cab rig through namchaind, and reads what the engine and the kernel say
# afterwards:
#
#   * engine.status: the render tail (worst_us, the load histogram, over_deadline) and xruns
#   * /proc/interrupts: which core took the DMA interrupt, and how many
#   * the IRQ thread's /proc/<tid>/schedstat: run_delay per wake, which is the wait to run
#
# Arm A is the rule (delivery on core 1: a render core, not the active one). Arm B is the comparator
# -- the placement P7 chose, and T6's original falsifier, where the interrupt shares the one core
# that also carries WiFi, the SD card and every service. Nothing is changed permanently: the affinity
# is written the way `pedal-tune apply` writes it, and the tree is untouched.
#
# The load is deliberately bounded -- 200 MB written and 200 MB uploaded per arm, both deleted after.
# The first version of this script asked for 1.2 GB and a 700 MB upload on a 2.9 GB card and filled
# it, which is a way to stall a measurement and a bad thing to do to the pedal's root filesystem.
#
# The report is printed and kept in <out>/t6.txt (default build/<host>/t6).
#
# Measured 2026-10-08 for T6: bench-results/2026-10-08-cost-table-vip/README.md, section 6.
set -u
CTL="/opt/namchain/current/bin/namchainctl --token-file /etc/namchain/token"
HOST=vip
RUN=240
MB=200
OUT=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --host) HOST=$2; shift ;;
    --seconds) RUN=$2; shift ;;
    --mb) MB=$2; shift ;;
    --out) OUT=$2; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "measure-irq: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT=${OUT:-$ROOT/build/$HOST/t6}
mkdir -p "$OUT"
# The report is the evidence, so it is kept as well as printed.
exec > >(tee "$OUT/t6.txt") 2>&1

[[ -f /tmp/t6-payload ]] || { mkfile -n "${MB}m" /tmp/t6-payload 2>/dev/null || dd if=/dev/zero of=/tmp/t6-payload bs=1m count="$MB" 2>/dev/null; }

snapshot() { # snapshot <label>
  ssh "$HOST" "sudo -n $CTL status --compact" | python3 -c "
import json,sys
s = json.load(sys.stdin)['status']
r = s['render']
print('    render: %s' % json.dumps({'worst_us': r['worst_us'], 'worst_percent': round(r['worst_percent'],2),
      'over_deadline': r['over_deadline'], 'over_90_percent': r['over_90_percent'],
      'histogram': r['load_histogram']}))
print('    xruns %d  guard_trips %d  blocks %d  queue %s' % (s['xruns'], s['guard_trips'], s['blocks'],
      json.dumps(s['queue'])))
"
  ssh "$HOST" 'grep -E "^ *138:" /proc/interrupts; t=$(pgrep -f "irq/138-dw_axi" | head -1); echo "    thread $t: $(cat /proc/$t/schedstat)  (exec_ns run_delay_ns wakes)"'
}

arm() { # arm <cpu> <label>
  local cpu=$1 label=$2
  echo
  echo "== arm $label: the DMA interrupt delivered on core $cpu, $RUN s of CPU, SD and WiFi load"
  ssh "$HOST" "echo $cpu | sudo -n tee /proc/irq/138/smp_affinity_list >/dev/null; echo -n '    affinity now: '; sudo -n cat /proc/irq/138/smp_affinity_list"
  snapshot before

  # The load: a spinner on core 0 (the housekeeping core the IRQ would share), one bounded SD write
  # and one bounded WiFi upload.
  ssh "$HOST" "taskset -c 0 yes > /dev/null 2>&1 & echo \$! > /var/tmp/t6-yes.pid; taskset -c 0 dd if=/dev/zero of=/var/tmp/t6-dd.bin bs=1M count=$MB conv=fsync 2>/dev/null" &
  local dd=$!
  scp -q -o ConnectTimeout=15 /tmp/t6-payload "$HOST:/var/tmp/t6-payload" &
  local scp_pid=$!
  sleep "$RUN"
  kill "$dd" "$scp_pid" 2>/dev/null || true
  wait "$dd" 2>/dev/null || true
  wait "$scp_pid" 2>/dev/null || true
  ssh "$HOST" 'kill "$(cat /var/tmp/t6-yes.pid)" 2>/dev/null; rm -f /var/tmp/t6-yes.pid' || true

  snapshot after
  ssh "$HOST" "rm -f /var/tmp/t6-dd.bin /var/tmp/t6-payload; df -h / | tail -1"
}

echo "T6: the audio IRQ's core. Rig: $(ssh "$HOST" "sudo -n $CTL status --compact" | python3 -c "import json,sys; print(json.load(sys.stdin)['status']['rig'])")"
echo "irqaffinity=0 at boot (1-3 isolated); tune.conf pins 138 to core 1; pedal-tune's own check is the authority."
arm 1 "A: render core, never the active one (D5)"
arm 0 "B: housekeeping core (the comparator)"
echo
echo "== done: the tree has not been touched; /proc/irq/138/smp_affinity_list is now $(ssh "$HOST" 'sudo -n cat /proc/irq/138/smp_affinity_list'), df $(ssh "$HOST" 'df -h / | tail -1 | awk "{print \$4\" free\"}"')"
