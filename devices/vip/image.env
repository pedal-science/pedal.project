# vip's card: what devices/common/make-card needs beyond rtpi's devices/vip/device.env (kernels,
# labels, partition numbers, command lines), which it reads from the rtpi commit in image.lock.
# Plain KEY=value, sourced by bash on the Mac and in the build container.

HOSTNAME=vip
USER_NAME=rik

# Partition sizes in MiB (docs/vip-image.md, "The card"). pedal-data is made just big enough for
# what the image puts there, and grows to fill the card on first boot (systemd-repart).
BOOTSEL_MB=64
PEDAL_BOOT_MB=512
RESCUE_BOOT_MB=256
RESCUE_ROOT_MB=1536
PEDAL_ROOT_MB=3072

# namchain, as deploy-engine builds it on piv.
NAMCHAIN_CXXFLAGS="-march=armv8-a -mtune=cortex-a76"

# Secrets (docs/vip-image.md, "The build"): the 1Password vault, the keychain item holding its
# service account's token, and the items. HOST_KEY_ITEM is made by the first build.
OP_VAULT=fx
OP_KEYCHAIN_LABEL=fx
WIFI_ITEM=wifi
TOKEN_ITEM=namchaind
HOST_KEY_ITEM=vip-ssh-host
