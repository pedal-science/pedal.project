{
  "backend": "alsa_raw",
  "device": "hw:CARD=wm8960,DEV=0",
  "sample_rate": 48000,
  "period_size": 64,
  "periods": 6,
  "capture_channels": 2,
  "playback_channels": 2,
  "rig": "last.json",
  "rigs_root": "/var/lib/pedal/library/rigs",
  "models_root": "/var/lib/pedal/library/models",
  "irs_root": "/var/lib/pedal/library/irs",
  "socket": "/run/namchain/namchaind.sock",
  "socket_mode": "0660",
  "rt_priority": 80,
  "cpu": 3,
  "warm_cpus": [1, 2],
  "warm_priority": 70,
  "lock_memory": true,
  "output_queue_periods": 4,
  "output_queue_floor_periods": 2,
  "fade_ms": 5,
  "cost_table": "/etc/namchain/cost.json",
  "device_retry_ms": 250,
  "levels_publish_period": true,
  "levels_rate_hz": 8,
  "tcp_listen": true,
  "tcp_address": "0.0.0.0",
  "tcp_port": 47810,
  "tcp_token_file": "/etc/namchain/token",
  "verbose": true
}
