#!/usr/bin/env bash
# devices/vip/test-offline-apply — does `pedal-device apply --root` turn a fresh root into vip's?
#
# Runs on the Mac, in colima's build container (devices/vip/spike's, until step 4 has its own):
# builds a minbase root from devices/vip/packages at the pinned snapshot, stages devices/common
# and devices/vip as devices/<host>/apply does (the host's files win), applies it offline, and
# checks what a booted vip would rely on. Nothing touches a board. About three minutes.

set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(git -C "$HERE" rev-parse --show-toplevel)
SNAPSHOT=${SNAPSHOT:-20260929T000000Z}

docker info >/dev/null 2>&1 || { echo "no docker: start colima" >&2; exit 1; }
docker build -q -t vip-build:spike --build-arg SNAPSHOT="$SNAPSHOT" "$REPO/devices/vip/spike" >/dev/null

exec docker run --rm -i \
  --cap-add SYS_ADMIN --security-opt apparmor=unconfined --security-opt seccomp=unconfined \
  -e SNAPSHOT="$SNAPSHOT" -v "$REPO/devices:/devices:ro" vip-build:spike bash -s <<'IN'
set -euo pipefail
MIRROR="https://snapshot.ubuntu.com/ubuntu/$SNAPSHOT"
R=/work/root; S=/work/stage
mkdir -p /work
pkgs=$(grep -v -e '^#' -e '^[[:space:]]*$' /devices/vip/packages | paste -sd, -)
echo "== root: minbase + devices/vip/packages"
mmdebstrap --quiet --variant=minbase --mode=root \
  --aptopt='APT::Install-Recommends "false"' --aptopt='Acquire::Check-Valid-Until "false"' \
  --components=main,restricted,universe --include="$pkgs" \
  resolute "$R" "deb $MIRROR resolute main restricted universe" "deb $MIRROR resolute-updates main restricted universe" 2>&1 | tail -2

echo "== stage: devices/common, then devices/vip on top"
mkdir -p "$S/rootfs"
cp -a /devices/common/rootfs/. "$S/rootfs/"
cp -a /devices/vip/rootfs/. "$S/rootfs/"
find "$S" -name .DS_Store -delete

echo "== apply --root"
SOURCE_DATE_EPOCH=0 bash "$S/rootfs/usr/local/sbin/pedal-device" apply "$S" --root "$R" --commit test

echo "== checks"
bad=0
pass() { printf '  ok    %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; bad=1; }
check() { if eval "$2"; then pass "$1"; else fail "$1"; fi; }

# every staged file is in the root, byte for byte, with the mode pedal-device gives it
( cd "$S/rootfs" && find . -type f | sed 's|^\./||' ) | while read -r f; do
  cmp -s "$S/rootfs/$f" "$R/$f" || echo "$f"; done > /work/differ
check "every staged file installed" '[[ ! -s /work/differ ]]'
check "scripts executable" '[[ -x $R/usr/local/sbin/pedal-tune && -x $R/usr/local/sbin/pedal-codec && -x $R/usr/local/bin/pedal-rt ]]'
check "vip's namchaind.json, on the codec" 'grep -q "hw:CARD=wm8960" $R/etc/namchain/namchaind.json'
check "codec files from common" '[[ -f $R/etc/pedal/codec/wm8960-codec-master.dts && -f $R/etc/pedal/codec/wm8960.mixer ]]'
check "no piv-only files" '[[ ! -e $R/etc/wireplumber ]]'
check "manifest paths are the host's, not the build's" '! grep -q /work "$R/var/lib/pedal/manifest" && grep -qx "file /etc/pedal/tune.conf" "$R/var/lib/pedal/manifest"'
check "applied stamp" 'grep -qx "commit=test" $R/etc/pedal/applied && grep -qx "applied=1970-01-01T00:00:00Z" $R/etc/pedal/applied'
for u in pedal-tune pedald pedal-codec; do
  check "$u enabled for multi-user" '[[ -L $R/etc/systemd/system/multi-user.target.wants/$u.service ]]'
done
check "pedald's package and entry point are installed" '[[ -f $R/usr/local/lib/pedald/daemon.py && -x $R/usr/local/sbin/pedald && -f $R/etc/pedal/pedald.json ]]'
check "pedal-resume is retired" '[[ ! -e $R/etc/systemd/system/pedal-resume.service && ! -e $R/usr/local/sbin/pedal-resume ]]'
check "the service's user exists in the image" 'grep -q "^pedal:" $R/etc/passwd'
check "and its unit names it" 'grep -qx "User=pedal" $R/etc/systemd/system/pedald.service'
check "pedal-wifi follows wlan0" '[[ -L $R/etc/systemd/system/sys-subsystem-net-devices-wlan0.device.wants/pedal-wifi.service ]]'
for u in apt-daily.timer apt-daily-upgrade.timer e2scrub_all.timer fstrim.timer dpkg-db-backup.timer; do
  if [[ -e $R/usr/lib/systemd/system/$u ]]; then
    check "$u masked" '[[ $(readlink $R/etc/systemd/system/$u) == /dev/null ]]'
  else pass "$u absent from the root (skipped)"; fi
done
check "masks recorded for revert" 'grep -q "^mask apt-daily.timer$" $R/var/lib/pedal/manifest'
check "tools pedal-* need are installed" 'for t in dtoverlay dtc amixer alsactl arecord chrt taskset flock ps python3 udevadm stty chown; do chroot $R sh -c "command -v $t" >/dev/null || { echo "    missing $t"; exit 1; }; done'
check "pedal-maint.target leaves the engine out" '! grep -q "multi-user\|namchaind" <(grep -v "^#" $R/etc/systemd/system/pedal-maint.target)'
check "pedal-maint.target lets users log in" 'grep -q "^Wants=.*systemd-user-sessions.service" $R/etc/systemd/system/pedal-maint.target'
check "eth0 not required for online" 'grep -qx "RequiredForOnline=no" $R/etc/systemd/network/20-eth0.network'
check "apply again changes nothing" 'before=$(cd $R && find etc usr/local var/lib/pedal -printf "%p %s %l\n" | sort | sha256sum); SOURCE_DATE_EPOCH=0 bash $S/rootfs/usr/local/sbin/pedal-device apply $S --root $R --commit test >/dev/null; after=$(cd $R && find etc usr/local var/lib/pedal -printf "%p %s %l\n" | sort | sha256sum); [[ $before == "$after" ]]'
check "the running host is untouched" '[[ ! -e /var/lib/pedal && ! -e /etc/pedal ]]'
echo "== root: $(du -sm $R | cut -f1) MB"
(( bad == 0 )) && echo "PASS" || { echo "FAILED"; exit 1; }
IN
