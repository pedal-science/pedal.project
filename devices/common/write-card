#!/usr/bin/env bash
# Write a card image to an SD card in a reader on this Mac. DESTRUCTIVE.
#
#   devices/common/write-card --image <file.img> [--disk /dev/diskN] [--confirm <word>]
#
# The guards this owns: external, removable, physical disks only; not the disk the Mac booted
# from; the card must hold the image; you type the confirmation word (default: the image's host,
# from the file name's first word) before anything is written. Then it writes to the raw node and
# reads it back in the same open, compares hashes and ejects. Needs sudo for the raw device.

set -euo pipefail
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
ok()   { printf '\033[1;32m[✓]\033[0m %s\n' "$*" >&2; }

IMAGE=""; DISK=""; WORD=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --image)   IMAGE=$2; shift 2 ;;
    --disk)    DISK=$2; shift 2 ;;
    --confirm) WORD=$2; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ -f $IMAGE ]] || die "usage: write-card --image <file.img> [--disk /dev/diskN]"
[[ -n $WORD ]] || WORD=$(basename "$IMAGE" | sed -E 's/[^a-z0-9].*//')
IMG_BYTES=$(stat -f %z "$IMAGE")

candidates() {
  diskutil list external physical 2>/dev/null | awk '/^\/dev\/disk[0-9]+ /{print $1}'
}
if [[ -z $DISK ]]; then
  mapfile_disks=($(candidates))
  case ${#mapfile_disks[@]} in
    0) die "no external physical disk: put the card in the reader" ;;
    1) DISK=${mapfile_disks[0]} ;;
    *) diskutil list external physical >&2; die "more than one external disk: pick one with --disk" ;;
  esac
fi
[[ $DISK =~ ^/dev/disk[0-9]+$ ]] || die "--disk must look like /dev/disk4, got: $DISK"

# The one mistake that cannot be undone is writing to the wrong disk, so check hard.
INFO=$(diskutil info "$DISK" 2>/dev/null) || die "$DISK does not exist"
field() { awk -F: -v k="$1" '$1 ~ k {sub(/^[^:]*: */,""); print; exit}' <<< "$INFO"; }
[[ $(field 'Device Location') == External ]] || die "$DISK is not an external disk. Refusing."
[[ $(field 'Removable Media') == Removable ]] || die "$DISK is not removable media. Refusing."
BOOT=$(diskutil info / | awk -F: '/Part of Whole/ {gsub(/ /,"",$2); print $2}')
[[ $DISK != "/dev/$BOOT" ]] || die "$DISK is the disk this Mac booted from. Refusing."
SIZE=$(field 'Disk Size' | sed -E 's/.*\(([0-9]+) Bytes\).*/\1/')
(( SIZE >= IMG_BYTES )) || die "$DISK ($SIZE bytes) is smaller than the image ($IMG_BYTES)."

log "image  : $IMAGE ($IMG_BYTES bytes)"
log "target : $DISK, $(field 'Device / Media Name'), $SIZE bytes"
diskutil list "$DISK" >&2
warn "EVERYTHING ON $DISK WILL BE DESTROYED."
read -r -p "Type '$WORD' to write it: " reply
[[ $reply == "$WORD" ]] || die "aborted: you typed '$reply'"

log "hashing the image"
IMG_SHA=$(shasum -a 256 "$IMAGE" | cut -d' ' -f1)
diskutil unmountDisk "$DISK" >/dev/null
RAW=${DISK/disk/rdisk}
# Write and read back through ONE open of the raw device. When a writer closes the whole disk,
# macOS rescans it and mounts any FAT partitions it finds, writing .fseventsd onto them, so a
# read-back after a separate dd compares against a card macOS has already changed.
log "writing to $RAW, then reading it back"
CARD_SHA=$(sudo /usr/bin/python3 - "$IMAGE" "$RAW" <<'PY'
import hashlib, os, sys, time
image, raw = sys.argv[1], sys.argv[2]
size, chunk = os.path.getsize(image), 4 << 20
fd = os.open(raw, os.O_RDWR)
def progress(what, done, t0):
    sys.stderr.write(f"\r   {what} {done >> 20} / {size >> 20} MiB, {done / max(time.time() - t0, 1e-3) / 1e6:.0f} MB/s ")
try:
    t0, done = time.time(), 0
    with open(image, "rb") as f:
        while buf := f.read(chunk):
            if len(buf) % 512:
                buf += b"\0" * (512 - len(buf) % 512)
            os.write(fd, buf); done += len(buf)
            if done % (64 << 20) == 0: progress("wrote", done, t0)
    os.fsync(fd); progress("wrote", size, t0); sys.stderr.write("\n")
    os.lseek(fd, 0, os.SEEK_SET)
    h, left, t0 = hashlib.sha256(), size, time.time()
    while left:
        buf = os.read(fd, min(chunk, (left + 511) // 512 * 512))
        if not buf: raise SystemExit("short read from the card")
        h.update(buf[:left]); left -= min(len(buf), left)
        if (size - left) % (64 << 20) == 0: progress("read ", size - left, t0)
    progress("read ", size, t0); sys.stderr.write("\n")
    print(h.hexdigest())
finally:
    os.close(fd)
PY
)
[[ $CARD_SHA == "$IMG_SHA" ]] || die "read-back hash differs: card $CARD_SHA, image $IMG_SHA"
ok "card matches the image ($IMG_SHA)"
# macOS may now mount the FAT partitions and add .fseventsd to them. Harmless to the Pi.
diskutil eject "$DISK" >/dev/null && ok "ejected: the card can come out"
