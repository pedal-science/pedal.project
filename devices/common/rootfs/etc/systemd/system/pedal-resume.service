[Unit]
Description=Pedal: save the running rig so the pedal resumes it at power-up
Documentation=file:/usr/local/sbin/pedal-resume
# Wants, not Requires: this follows the engine, and never takes it down or holds it up.
Wants=namchaind.service
After=namchaind.service

[Service]
ExecStart=/usr/local/sbin/pedal-resume run
Restart=always
RestartSec=2
# A housekeeping job: off the render core, below everything that matters.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
