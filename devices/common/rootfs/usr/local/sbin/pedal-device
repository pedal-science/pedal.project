#!/usr/bin/env bash
# pedal-device — install, check and remove the pedal host's appliance configuration. Runs on the
# host, as root. The Mac side (devices/<host>/apply in pedal.project) stages the tree and calls this.
#
#   pedal-device apply <stage-dir> [--dry-run] [--commit <id>] [--root <dir>]
#   pedal-device revert [--dry-run]
#   pedal-device status
#
# <stage-dir> holds rootfs/: devices/common/rootfs with devices/<host>/rootfs on top. Every file there is installed at the
# same path. Everything done is recorded in /var/lib/pedal/manifest, and revert undoes exactly
# that list. A file that already existed and was not ours is saved first and put back on revert.
#
# --root <dir> applies to a root filesystem that isn't running: the image build's (vip's card,
# docs/vip-image.md). Files go under <dir>, units are enabled and masked with systemctl --root,
# and nothing is started, reloaded or set at runtime; the manifest inside <dir> names the paths
# as the running host will see them, so revert works there later. The image is then exactly
# "a fresh root + apply".
#
# It touches no package, no boot asset and no kernel setting: those are rtpi's.

set -euo pipefail

# ROOT is empty on a running host, or the image build's root with --root. Paths in the manifest
# never include it.
ROOT=""
STATE=/var/lib/pedal
MANIFEST=$STATE/manifest
SAVED=$STATE/preexisting
LOCK=/run/lock/$(hostname).lock  # the same lock scripts/host-lock will take (tib.lock on tib)

# namchain's tools/soak/host-slim.sh configured tib and piv before this tree existed. apply takes
# its place: it removes host-slim's files (saving them) and takes over the masks we share. The
# realtime limits in audio.conf (tib) and 99-namchain-audio.conf (piv) were written by hand during
# namchain's plan-rt work, and are now in 90-pedal-rt.conf.
HOSTSLIM_MANIFEST=/var/lib/namchain/host-slim/manifest
HOSTSLIM_UNITS=(namchain-host-slim-vmstat.service namchain-host-slim-initconfine.service)
ADOPT_FILES=(/etc/security/limits.d/audio.conf /etc/security/limits.d/99-namchain-audio.conf)

DRY=0
say()  { echo "pedal-device: $*"; }
run()  { if (( DRY )); then echo "  DRY   $*"; else "$@"; fi; }
record() { (( DRY )) || grep -qxF "$1" "$ROOT$MANIFEST" 2>/dev/null || echo "$1" >> "$ROOT$MANIFEST"; }
recorded() { grep -qxF "$1" "$ROOT$MANIFEST" 2>/dev/null; }
offline() { [[ -n $ROOT ]]; }
# systemctl, or the root's own systemctl run in it when applying offline: that is the systemd the
# host will boot, and the build container may have none.
sctl() { if offline; then chroot "$ROOT" systemctl "$@"; else systemctl "$@"; fi; }

save_preexisting() {   # save a file that is not ours before replacing or removing it
  local f=$1
  [[ -e $ROOT$f ]] || return 0
  recorded "file $f" && return 0
  run install -D -m 0644 "$ROOT$f" "$ROOT$SAVED$f"
  record "saved $f"
}

adopt() {
  local kind what u f
  if [[ -r $HOSTSLIM_MANIFEST ]]; then
    say "taking over from namchain host-slim"
    for u in "${HOSTSLIM_UNITS[@]}"; do
      systemctl cat "$u" >/dev/null 2>&1 && run systemctl disable --now "$u"
    done
    while read -r kind what _; do
      case $kind in
        # Kept in $STATE/adopted for reference, but not restored by revert: half of host-slim
        # (files without their enabled units) would be worse than none of it.
        file) [[ -e $what ]] && { run install -D -m 0644 "$what" "$STATE/adopted$what"; run rm -f "$what"; } ;;
        mask) grep -qxF "$what" <(units) || run systemctl unmask "$what" ;;
      esac
    done < "$HOSTSLIM_MANIFEST"
    while read -r kind what _; do
      [[ $kind == dir ]] && run rmdir "$what" 2>/dev/null || true
    done < "$HOSTSLIM_MANIFEST"
    # The masks we share are ours now, so revert unmasks them.
    while read -r kind what _; do
      [[ $kind == mask ]] && grep -qxF "$what" <(units) && record "mask $what"
    done < "$HOSTSLIM_MANIFEST"
    run install -D -m 0644 "$HOSTSLIM_MANIFEST" "$STATE/adopted/host-slim.manifest"
    run rm -f "$HOSTSLIM_MANIFEST"
  fi
  for f in "${ADOPT_FILES[@]}"; do
    [[ -e $f ]] || continue
    say "taking over $f"
    save_preexisting "$f"
    run rm -f "$f"
  done
}

units() { grep -v -e '^#' -e '^[[:space:]]*$' "${UNITS_FILE:-/etc/pedal/masked-units}"; }

install_tree() {
  local root=$1 rel dst mode
  while IFS= read -r rel; do
    dst=/${rel#./}
    if [[ -e $ROOT$dst ]] && cmp -s "$root/$rel" "$ROOT$dst"; then record "file $dst"; continue; fi
    save_preexisting "$dst"
    case $dst in */bin/*|*/sbin/*) mode=0755 ;; *) mode=0644 ;; esac
    run install -D -m "$mode" -o root -g root "$root/$rel" "$ROOT$dst"
    record "file $dst"
    echo "  installed $dst"
  done < <(cd "$root" && find . -type f | sed "s|^\./||" | sort)
}

# A line "user:<unit>" masks a per-user unit for every user (systemctl --global); anything else is
# a system unit.
sc() { if [[ $1 == user:* ]]; then echo "sctl --global"; else echo sctl; fi; }
unit_exists() {
  local u=${1#user:}
  if [[ $1 == user:* ]]; then [[ -n $(find "$ROOT/usr/lib/systemd/user" "$ROOT/etc/systemd/user" -name "$u" 2>/dev/null) ]]
  elif offline; then [[ -n $(find "$ROOT/usr/lib/systemd/system" "$ROOT/lib/systemd/system" "$ROOT/etc/systemd/system" -maxdepth 1 -name "$u" 2>/dev/null) ]]
  else systemctl cat "$u" >/dev/null 2>&1; fi
}

mask_units() {
  local u st
  while IFS= read -r u; do
    unit_exists "$u" || { echo "  absent    $u"; continue; }
    st=$($(sc "$u") is-enabled "${u#user:}" 2>/dev/null || true)
    if [[ $st == masked ]]; then
      recorded "mask $u" || echo "  masked by someone else, left alone: $u"
      continue
    fi
    run $(sc "$u") mask "${u#user:}" >/dev/null
    record "mask $u"
    echo "  masked    $u"
  done < <(units)
  # A masked timer whose service is also masked reports result=resources in systemctl --failed.
  # It cannot fire, so clear the noise rather than let it hide a real failure later.
  offline || run systemctl reset-failed >/dev/null 2>&1 || true
}

# The image build: enable what apply would enable, start nothing. The first boot brings it into force.
activate_offline() {
  local u
  # The service's user has to exist in the image, not only on a host that applied: a card written
  # from this root starts pedald.service with `User=pedal`, and `pedald seed` (root, before
  # namchaind) chowns the state tree to it. Without this the unit fails on a fresh card until
  # somebody applies — which the image build has already done, so nobody would.
  if [[ -x $ROOT/usr/bin/systemd-sysusers || -x $ROOT/usr/sbin/systemd-sysusers ]]; then
    run chroot "$ROOT" systemd-sysusers && echo "  sysusers  pedal service user"
  else
    echo "  note      no systemd-sysusers in the root: the pedal user is missing from it"
  fi
  for u in pedal-tune.service pedal-uart.service pedald.service pedal-codec.service pedal-wifi.service; do
    [[ -e $ROOT/etc/systemd/system/$u ]] || continue
    run sctl enable "$u" >/dev/null 2>&1
    echo "  enabled   $u"
  done
}

# pedal-resume's job (save the running rig) folds into pedald, and two writers of last.json is
# one too many. Its unit and script leave the tree, but apply only ever installs files, so a
# host that has them from an earlier apply has to lose them here.
retire_resume() {
  local f
  for f in /etc/systemd/system/pedal-resume.service /usr/local/sbin/pedal-resume; do
    recorded "file $f" || continue
    [[ $f == *.service ]] && run systemctl disable --now pedal-resume.service
    run rm -f "$f"
    (( DRY )) || sed -i "\|^file $f\$|d" "$MANIFEST"
    echo "  retired   $f"
  done
}

# The service's own user (usr/lib/sysusers.d/pedal.conf): configuration like the rest of this
# tree, not something somebody did to a board once. Idempotent, and it says nothing when the
# user is already there.
sysusers() {
  command -v systemd-sysusers >/dev/null 2>&1 || { echo "  no systemd-sysusers: pedal user left to the image"; return 0; }
  run systemd-sysusers
}

activate() {
  local conf=$1 hk
  hk=$(. "$conf"; echo "${HOUSEKEEPING_CPUS:-}")
  run systemctl daemon-reload
  # The drop-ins are read at daemon-reload, but a running slice's cgroup is only rewritten when
  # a property is set, so set it now too.
  if [[ -n $hk ]]; then
    local d
    for d in /etc/systemd/system/*.slice.d/10-pedal-cpuset.conf; do
      [[ -e $d ]] || continue
      d=${d%.d/*}; run systemctl set-property --runtime "${d##*/}" AllowedCPUs="$hk"
    done
  fi
  run sysctl -q -p /etc/sysctl.d/90-pedal.conf
  run systemctl restart systemd-journald
  run systemctl enable pedal-tune.service
  run systemctl restart pedal-tune.service
  # namchaind itself is installed and enabled by scripts/deploy-engine, with its binaries.
  # pedald carries the resume job now, so pedal-resume retires and the user it runs as is made.
  retire_resume
  sysusers
  # The link's UART, before the service that opens it. Restarted rather than only enabled, so a
  # host whose boot lost the node gets it back without a reboot: 2026-10-05, a re-paved card came
  # up with serial@30000 disabled and pedald had no /dev/ttyAMA0 to open.
  if [[ -e /etc/systemd/system/pedal-uart.service ]]; then
    run systemctl enable pedal-uart.service
    run systemctl restart pedal-uart.service
  fi
  run systemctl enable pedald.service
  run systemctl restart --no-block pedald.service
  # Every Pi host ships this unit; it fails, harmlessly, where no codec is wired.
  if [[ -e /etc/systemd/system/pedal-codec.service ]]; then
    run systemctl enable pedal-codec.service
    run systemctl restart pedal-codec.service
  fi
  # The unit follows wlan0, so it is only started where there is one: elsewhere the start would
  # wait for a device that never comes.
  run systemctl enable pedal-wifi.service
  if [[ -e /sys/class/net/wlan0 ]]; then
    run systemctl restart pedal-wifi.service
  fi
}

do_apply() {
  local stage=$1 commit=$2
  [[ -d $stage/rootfs ]] || { say "no rootfs/ in $stage"; exit 2; }
  UNITS_FILE=$stage/rootfs/etc/pedal/masked-units
  (( DRY )) && say "DRY RUN: nothing will change"
  offline && say "offline: applying to $ROOT, starting nothing"
  run mkdir -p "$ROOT$STATE"; (( DRY )) || touch "$ROOT$MANIFEST"
  offline || adopt
  install_tree "$stage/rootfs"
  mask_units
  if offline; then activate_offline; else activate "$stage/rootfs/etc/pedal/tune.conf"; fi
  if (( ! DRY )); then
    # SOURCE_DATE_EPOCH, when the image build sets it, keeps the image reproducible.
    printf 'commit=%s\napplied=%s\n' "$commit" "$(date -u ${SOURCE_DATE_EPOCH:+-d @$SOURCE_DATE_EPOCH} +%FT%TZ)" > "$ROOT/etc/pedal/applied"
    record "file /etc/pedal/applied"
  fi
  say "done. Manifest: $ROOT$MANIFEST"
}

do_revert() {
  local kind what
  [[ -r $MANIFEST ]] || { say "nothing to revert: no $MANIFEST"; exit 0; }
  systemctl cat pedal-tune.service >/dev/null 2>&1 && run systemctl disable --now pedal-tune.service
  # The overlay it loaded stays in the tree until the next reboot, as the codec's does.
  systemctl cat pedal-uart.service >/dev/null 2>&1 && run systemctl disable pedal-uart.service
  systemctl cat pedald.service >/dev/null 2>&1 && run systemctl disable --now pedald.service
  systemctl cat pedal-resume.service >/dev/null 2>&1 && run systemctl disable --now pedal-resume.service
  systemctl cat pedal-codec.service >/dev/null 2>&1 && run systemctl disable pedal-codec.service
  # Stopped while its helper is still installed: stopping it turns power saving back on.
  systemctl cat pedal-wifi.service >/dev/null 2>&1 && run systemctl disable --now pedal-wifi.service
  while read -r kind what; do
    case $kind in
      mask) run $(sc "$what") unmask "${what#user:}" >/dev/null; echo "  unmasked  $what" ;;
      file) run rm -f "$what"; echo "  removed   $what" ;;
    esac
  done < "$MANIFEST"
  while read -r kind what; do
    [[ $kind == saved ]] || continue
    run install -D -m 0644 "$SAVED$what" "$what"; echo "  restored  $what"
  done < "$MANIFEST"
  local s
  for s in system user machine; do run rmdir "/etc/systemd/system/$s.slice.d" 2>/dev/null || true; done
  run rmdir /etc/pedal 2>/dev/null || true
  run systemctl daemon-reload
  for s in system user machine; do run systemctl set-property --runtime "$s.slice" AllowedCPUs= 2>/dev/null || true; done
  run systemctl set-property --runtime init.scope AllowedCPUs=
  run systemctl restart systemd-journald
  local p
  for p in /sys/devices/system/cpu/cpufreq/policy*; do
    (( DRY )) || cat "$p/cpuinfo_max_freq" > "$p/scaling_max_freq"
  done
  (( DRY )) || mv "$MANIFEST" "$MANIFEST.reverted-$(date -u +%Y%m%dT%H%M%SZ)"
  say "reverted. The audio interrupt keeps its affinity and priority until the next reboot."
  say "host-slim's files, if this took over from it, are in $STATE/adopted and $SAVED."
}

do_status() {
  [[ -r /etc/pedal/applied ]] && cat /etc/pedal/applied || echo "commit=<not applied>"
  local u st n=0 bad=0 wifi
  if [[ -r /etc/pedal/masked-units ]]; then
    while IFS= read -r u; do
      unit_exists "$u" || continue
      st=$($(sc "$u") is-enabled "${u#user:}" 2>/dev/null || true)
      if [[ $st == masked ]]; then n=$((n+1)); else printf '  FAIL  %-34s %s (want masked)\n' "$u" "$st"; bad=1; fi
    done < <(units)
    printf '  ok    %-34s %s\n' "masked units" "$n"
  fi
  if [[ -e /sys/class/net/wlan0 && -x /usr/local/sbin/pedal-wifi ]]; then
    wifi=$(/usr/local/sbin/pedal-wifi status wlan0 2>&1 || true)
    if [[ $wifi == "wlan0: power saving off" ]]; then printf '  ok    %-34s %s\n' "wlan0 power saving" "off"
    else printf '  FAIL  %-34s %s (want off)\n' "wlan0 power saving" "${wifi#wlan0: power saving }"; bad=1; fi
  fi
  # This device's measured cost table (P2). Printed rather than asserted: the table is a measurement,
  # and whether it is the right one for what the device runs is `devices/<host>/check`'s question
  # (it compares the engine commit and the kernel with the host's own).
  if [[ -r /etc/namchain/cost.json ]] && command -v python3 >/dev/null 2>&1; then
    python3 - /etc/namchain/cost.json <<-'PY' || bad=1
			import json, sys
			try:
			    doc = json.load(open(sys.argv[1]))
			    core = doc.get("core_percent") or {}
			    rows = sum(len(v) for v in core.values() if isinstance(v, dict))
			    print("  ok    %-34s %s" % ("cost table",
			          "%s, measured %s, engine %s, %s, headroom %.2f, %d row(s)"
			          % (doc.get("host"), doc.get("measured"), doc.get("engine_commit"),
			             doc.get("kernel"), doc.get("headroom", 0.0), rows)))
			except Exception as exc:
			    print("  FAIL  %-34s %s" % ("cost table", "cannot be read: %s" % exc))
			    sys.exit(1)
		PY
  else
    printf '  --    %-34s %s\n' "cost table" "not installed: the engine charges every unit its unknown cost"
  fi
  printf '  --    %-34s %s\n' "pedal-tune.service" "$(systemctl is-enabled pedal-tune.service 2>/dev/null) / $(systemctl is-active pedal-tune.service 2>/dev/null)"
  [[ -x /usr/local/sbin/pedal-tune ]] && /usr/local/sbin/pedal-tune check || bad=1
  return $bad
}

[[ $(id -u) -eq 0 ]] || { say "run as root"; exit 2; }
cmd=${1:-}; shift || true
stage=""; commit="unknown"
while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run) DRY=1 ;;
    --commit) commit=$2; shift ;;
    --root) ROOT=$(cd "$2" && pwd); [[ $ROOT != / ]] || ROOT=""; shift ;;
    *) stage=$1 ;;
  esac
  shift
done

if offline; then
  [[ $cmd == apply ]] || { say "--root is for apply only"; exit 2; }
  do_apply "${stage:?usage: pedal-device apply <stage-dir> --root <dir>}" "$commit"
  exit 0
fi
exec 9> "$LOCK"
case $cmd in
  apply)  flock -n 9 || { say "$(hostname) is locked by another job ($LOCK)"; exit 3; }
          do_apply "${stage:?usage: pedal-device apply <stage-dir>}" "$commit" ;;
  revert) flock -n 9 || { say "$(hostname) is locked by another job ($LOCK)"; exit 3; }
          do_revert ;;
  status) do_status ;;
  *) sed -n '2,19p' "$0"; exit 2 ;;
esac
