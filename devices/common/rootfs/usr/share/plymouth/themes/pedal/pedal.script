# The pedal's boot splash: the rigpa mark and wordmark on the same near-black the app uses.
# Static on purpose: it costs nothing while the engine, pedald and the disk come up.
#
# No Scale() and no conditionals: the script plugin is small, and the first version's
# conditional + fractional Scale() segfaulted plymouthd on vip (a splash that crashes is worse
# than none). splash.png is 1200x480; centring it shows the mark and the wordmark on the 800x480
# panel and on a bar, with the edges cropped or padded.
Window.SetBackgroundTopColor(0.043, 0.043, 0.043);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.043);
splash = Image("splash.png");
sprite = Sprite(splash);
sprite.SetX((Window.GetWidth() - splash.GetWidth()) / 2);
sprite.SetY((Window.GetHeight() - splash.GetHeight()) / 2);
