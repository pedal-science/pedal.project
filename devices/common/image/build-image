#!/usr/bin/env bash
# Runs INSIDE the build container (devices/common/make-card starts it). Builds a Pi host's card
# image: namchain, the pedal root, the rescue root, the boot partitions, pedal-data, the GPT.
# docs/vip-image.md says why each piece is the way it is.
#
# In:  /in/pedal, /in/rtpi, /in/namchain   the inputs, exported at their pinned commits
#      /in/inputs                           name=commit lines for them, plus snapshot and the
#                                           pedal kernel's release, kind, commit and hashes
#      /in/kernel                           rtpi's kernel artefacts (boot/modules tarballs and
#                                           their gates), verified against the lock by make-card
#      /in/authorized_keys                  public keys for the user
#      stdin                                the secrets, never written anywhere but the roots:
#                                           WiFi SSID, WiFi passphrase, namchaind token (one line
#                                           each), then the SSH host key (OpenSSH, to EOF)
#      HOST                                 from the environment
# Out: /out/<host>.img, /out/manifest, /out/packages-{pedal,rescue}.txt, /out/tree-*.txt

set -euo pipefail
log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

: "${HOST:?}"
IN=/in; W=/work; OUT=/out
DEV=$IN/pedal/devices/$HOST
declare -A PIN
while IFS='=' read -r k v; do [[ -n $k ]] && PIN[$k]=$v; done < "$IN/inputs"
SNAPSHOT=${PIN[snapshot]}
# shellcheck disable=SC1091
source "$DEV/image.env"
# rtpi's device facts: kernels, labels, partition numbers, the command lines. KEY=value and
# KEY="value" only (vip-boot reads it without a shell), so sourcing it is safe.
RTPI_DEV=$IN/rtpi/devices/$HOST
# shellcheck disable=SC1091
source "$RTPI_DEV/device.env"
MIRROR="https://snapshot.ubuntu.com/ubuntu/$SNAPSHOT"
export SOURCE_DATE_EPOCH=$(date -u -d "${SNAPSHOT:0:8} ${SNAPSHOT:9:2}:${SNAPSHOT:11:2}:${SNAPSHOT:13:2}" +%s)
export E2FSPROGS_FAKE_TIME=$SOURCE_DATE_EPOCH
# Stable identifiers, so a rebuild with the same pins makes the same card, bar the secrets.
uuid() { python3 -c "import uuid,sys; print(uuid.uuid5(uuid.NAMESPACE_URL, 'pedal/' + sys.argv[1]))" "$HOST/$1"; }

# ------------------------------------------------------------------ the two kernels
# The pedal's kernel is rtpi's rebuild, which is in no archive: it arrives as artefacts and is
# installed into the root below (docs/vip-kernel-image.md). The stock kernel is an ordinary
# package, and it is what the spare slot boots — so it has to be in the same root.
[[ -n $PEDAL_KERNEL ]] || die "device.env has no PEDAL_KERNEL"
if [[ -z ${FALLBACK_KERNEL:-} ]]; then
  die "device.env has no FALLBACK_KERNEL: the spare slot would have no kernel"
fi
if [[ -z ${PIN[kernel]:-} ]]; then
  die "/in/inputs has no kernel=: the card was built without the kernel artefacts (make-card says why)"
fi
[[ ${PIN[kernel]} == "$PEDAL_KERNEL" ]] \
  || die "the lock pins ${PIN[kernel]} and device.env names $PEDAL_KERNEL: they must be the same rebuild"
for p in "linux-image-$FALLBACK_KERNEL" "linux-modules-$FALLBACK_KERNEL"; do
  grep -qx "$p" "$DEV/packages" \
    || die "devices/$HOST/packages does not install $p: slot b would have no kernel to boot"
done

# ------------------------------------------------------------------ secrets
IFS= read -r WIFI_SSID || die "no WiFi SSID on stdin"
IFS= read -r WIFI_PSK  || die "no WiFi passphrase on stdin"
IFS= read -r TOKEN     || die "no namchaind token on stdin"
HOST_KEY=$(cat)
[[ -n $WIFI_SSID && ${#WIFI_PSK} -ge 8 ]] || die "WiFi SSID empty or passphrase too short"
[[ ${#TOKEN} -ge 32 ]] || die "namchaind token too short"
[[ $HOST_KEY == "-----BEGIN OPENSSH PRIVATE KEY-----"* ]] || die "the SSH host key isn't an OpenSSH private key"
[[ -s $IN/authorized_keys ]] || die "no authorized_keys"
# Paths that hold them: listed in the tree files without a content hash.
SECRET_PATHS='^(etc/wpa_supplicant/wpa_supplicant-wlan0\.conf|etc/namchain/token|etc/ssh/ssh_host_ed25519_key)$'

rm -rf "$W"; mkdir -p "$W"
PEDAL=$W/pedal; RESCUE=$W/rescue; DATA=$W/data

# ------------------------------------------------------------------ namchain
NC_COMMIT=${PIN[namchain]}; NC_SHORT=${NC_COMMIT:0:7}
log "namchain $NC_SHORT: build and test (Release, $NAMCHAIN_CXXFLAGS)"
cp -a "$IN/namchain" "$W/namchain-src"
"$IN/pedal/devices/common/image/build-namchain" "$W/namchain-src" "$NAMCHAIN_CXXFLAGS" "$W"
cp "$W/namchain-configure.log" "$W/namchain-test.log" "$OUT/"

# ------------------------------------------------------------------ roots
pkglist() { grep -v -e '^#' -e '^[[:space:]]*$' "$1" | paste -sd, -; }
mkroot() {  # mkroot <dir> <package file>
  mmdebstrap --quiet --variant=minbase --mode=root \
    --aptopt='APT::Install-Recommends "false"' --aptopt='Acquire::Check-Valid-Until "false"' \
    --components=main,restricted,universe --include="$(pkglist "$2")" \
    resolute "$1" \
    "deb $MIRROR resolute main restricted universe" \
    "deb $MIRROR resolute-updates main restricted universe"
}
# Run a command in a root with /proc, /sys and /dev, as mmdebstrap's hooks have them.
inroot() {
  local r=$1; shift
  mount -t proc proc "$r/proc"; mount --rbind /sys "$r/sys"; mount --rbind /dev "$r/dev"
  local rc=0; chroot "$r" "$@" || rc=$?
  umount -R "$r/dev"; umount -R "$r/sys"; umount "$r/proc"
  return $rc
}
log "pedal root: minbase + devices/$HOST/packages"
mkroot "$PEDAL" "$DEV/packages"
log "rescue root: minbase + devices/$HOST/rescue-packages"
mkroot "$RESCUE" "$DEV/rescue-packages"

# What both roots share: the name, the user and their keys, the host key, the network, the
# watchdog, rtpi's vip-boot. Both are the same machine to ssh, whichever is running.
common() {  # common <root> <kind>
  local r=$1 kind=$2
  echo "$HOSTNAME" > "$r/etc/hostname"
  printf '127.0.0.1 localhost\n127.0.1.1 %s\n' "$HOSTNAME" > "$r/etc/hosts"
  # Empty: systemd makes one at boot (committed on the pedal, in /run on read-only rescue). Not
  # "uninitialized", which makes it a first boot: systemd-firstboot then waits on tty1 for a
  # locale and a root password with the other consoles muted, and nothing after sysinit.target
  # ever starts (vip's first card, 2026-09-30); and preset-all would re-enable units.
  : > "$r/etc/machine-id"
  chroot "$r" systemctl mask -q systemd-firstboot.service

  chroot "$r" useradd -m -s /bin/bash -G sudo "$USER_NAME"
  local uid; uid=$(chroot "$r" id -u "$USER_NAME")
  install -d -m 700 -o "$uid" -g "$uid" "$r/home/$USER_NAME/.ssh"
  install -m 600 -o "$uid" -g "$uid" "$IN/authorized_keys" "$r/home/$USER_NAME/.ssh/authorized_keys"
  echo "$USER_NAME ALL=(ALL) NOPASSWD:ALL" > "$r/etc/sudoers.d/10-$USER_NAME"
  chmod 440 "$r/etc/sudoers.d/10-$USER_NAME"

  # One host key, kept in 1Password, so a reflashed card is the same machine to ssh.
  rm -f "$r"/etc/ssh/ssh_host_*
  (umask 077; printf '%s\n' "$HOST_KEY" > "$r/etc/ssh/ssh_host_ed25519_key")
  ssh-keygen -y -f "$r/etc/ssh/ssh_host_ed25519_key" | sed "s/\$/ root@$HOSTNAME/" > "$r/etc/ssh/ssh_host_ed25519_key.pub"
  printf '# The one host key, from 1Password (devices/%s/image.env, HOST_KEY_ITEM).\nHostKey /etc/ssh/ssh_host_ed25519_key\n' "$HOST" \
    > "$r/etc/ssh/sshd_config.d/05-host-key.conf"
  install -m 644 "$DEV/rootfs/etc/ssh/sshd_config.d/10-pedal-keys-only.conf" "$r/etc/ssh/sshd_config.d/"

  # networkd on eth0 and wlan0, mDNS by resolved, wpa_supplicant for wlan0. The pedal's copies
  # of the .network files come from devices/<host> through apply; rescue takes the same ones.
  install -d "$r/etc/systemd/network" "$r/etc/wpa_supplicant" "$r/etc/systemd/resolved.conf.d"
  cp "$DEV"/rootfs/etc/systemd/network/*.network "$r/etc/systemd/network/"
  cp "$DEV"/rootfs/etc/systemd/resolved.conf.d/*.conf "$r/etc/systemd/resolved.conf.d/"
  (
    umask 077
    {
      echo 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev'
      echo 'country=GB'
      echo 'network={'
      printf '  ssid="%s"\n' "$WIFI_SSID"
      # A 64-hex key is a hashed PSK and only works unquoted; quoted, it's a passphrase
      # (bench-results/vip-spike: the error message prints it).
      if [[ $WIFI_PSK =~ ^[0-9a-fA-F]{64}$ ]]; then printf '  psk=%s\n' "$WIFI_PSK"
      else printf '  psk="%s"\n' "$WIFI_PSK"; fi
      echo '}'
    } > "$r/etc/wpa_supplicant/wpa_supplicant-wlan0.conf"
  )
  ln -sf /run/systemd/resolve/stub-resolv.conf "$r/etc/resolv.conf"
  chroot "$r" systemctl enable -q systemd-networkd systemd-resolved systemd-timesyncd wpa_supplicant@wlan0 ssh
  # sshd as a service (vip-boot-validate orders itself after ssh.service), not also the socket
  # Ubuntu enables, which would contend for port 22. No sshd-keygen: the one host key is above,
  # and on rescue's read-only root the keygen would fail.
  chroot "$r" systemctl disable -q ssh.socket
  chroot "$r" systemctl mask -q sshd-keygen.service

  # The watchdog, in the root and (dracut.conf.d) in its initramfs. rtpi's files.
  install -D -m 644 "$RTPI_DEV/etc/systemd/system.conf.d/10-rtpi-watchdog.conf" "$r/etc/systemd/system.conf.d/10-rtpi-watchdog.conf"
  install -D -m 644 "$RTPI_DEV/etc/dracut.conf.d/20-rtpi-watchdog.conf" "$r/etc/dracut.conf.d/20-rtpi-watchdog.conf"
  install -D -m 644 "$RTPI_DEV/device.env" "$r/etc/rtpi/device.env"
  install -D -m 755 "$RTPI_DEV/usr/local/sbin/vip-boot" "$r/usr/local/sbin/vip-boot"
  install -d "$r$BOOTSEL_MOUNT"
  printf '%s=%s\n' commit "${PIN[pedal]}" rtpi "${PIN[rtpi]}" namchain "$NC_COMMIT" snapshot "$SNAPSHOT" root "$kind" \
    > "$r/etc/pedal-image"
}
initramfs() {  # initramfs <root> <release>
  inroot "$1" dracut --quiet --force --reproducible --no-hostonly --kver "$2" \
    --add-drivers "sdhci-brcmstb sdhci-iproc mmc_block ext4 vfat" "/boot/initrd.img-$2"
}

log "pedal root: customise"
common "$PEDAL" pedal
install -d "$PEDAL$PEDAL_BOOT_MOUNT" "$PEDAL/var/lib/pedal"
cat > "$PEDAL/etc/fstab" <<EOF
# The pedal root (docs/vip-image.md, "The card"). The boot partitions are vip-boot's to mount.
LABEL=$PEDAL_ROOT_LABEL  /                  ext4  defaults,noatime                   0 1
LABEL=pedal-data  /var/lib/pedal     ext4  defaults,noatime,nofail,x-systemd.growfs  0 2
LABEL=$PEDAL_BOOT_LABEL  $PEDAL_BOOT_MOUNT     vfat  defaults,noauto,nofail  0 0
LABEL=$BOOTSEL_LABEL     $BOOTSEL_MOUNT      vfat  defaults,noauto,nofail  0 0
EOF
# pedal-data grows into the rest of the card on first boot: it's the one partition of the
# generic Linux type (the roots are root-arm64), so this matches it and nothing else.
install -d "$PEDAL/etc/repart.d"
cat > "$PEDAL/etc/repart.d/50-pedal-data.conf" <<'EOF'
# pedal-data takes the rest of the card on first boot (docs/vip-image.md). The roots are of type
# root-arm64, so this matches pedal-data alone; fstab's x-systemd.growfs grows its filesystem.
[Partition]
Type=linux-generic
Label=pedal-data
EOF
# rtpi: the boot counter in the initramfs, validation and settling of candidates, the guard.
# A boot that lands in emergency mode, or never reaches the engine, reboots so the initramfs
# counts it (step 6): the emergency and rescue drop-ins, and vip-boot-deadline.
for f in etc/dracut.conf.d/30-vip-guard.conf \
         etc/systemd/system/vip-boot-settle.service etc/systemd/system/vip-boot-validate.service \
         etc/systemd/system/pedal-guard.service etc/systemd/system/pedal-guard-maint.service \
         etc/systemd/system/emergency.service.d/10-vip-reboot.conf \
         etc/systemd/system/rescue.service.d/10-vip-reboot.conf \
         etc/systemd/system/vip-boot-deadline.service; do
  install -D -m 644 "$RTPI_DEV/$f" "$PEDAL/$f"
done
install -D -m 755 "$RTPI_DEV/usr/local/libexec/vip-boot-validate" "$PEDAL/usr/local/libexec/vip-boot-validate"
install -D -m 755 "$RTPI_DEV/usr/local/sbin/vip-install-kernel" "$PEDAL/usr/local/sbin/vip-install-kernel"
cp -a "$RTPI_DEV/usr/lib/dracut/modules.d/95vip-guard" "$PEDAL/usr/lib/dracut/modules.d/"

# The pedal kernel, from the artefacts make-card verified. rtpi's own script does it, so the
# image and a live deploy share one version of the gates, the device-tree copy and the dracut
# invocation (docs/vip-kernel-image.md). It runs inside the root, with /proc, /sys and /dev, and
# builds that release's guarded initramfs as it goes.
log "pedal root: the pedal kernel $PEDAL_KERNEL, from rtpi's artefacts"
install -d "$PEDAL/tmp/kernel"
cp -a "$IN/kernel/." "$PEDAL/tmp/kernel/"
inroot "$PEDAL" /usr/local/sbin/vip-install-kernel --artefacts /tmp/kernel
rm -rf "$PEDAL/tmp/kernel"
# The kernel bytes each slot will boot: the manifest records them, and `--remote` compares the
# board's booted slot against them before it writes a root under it (image/remote).
PEDAL_VMLINUZ_SHA=$(sha256sum "$PEDAL/boot/vmlinuz-$PEDAL_KERNEL" | cut -d' ' -f1)
FALLBACK_VMLINUZ_SHA=$(sha256sum "$PEDAL/boot/vmlinuz-$FALLBACK_KERNEL" | cut -d' ' -f1)
# The board's own record of which kernel it carries and where it came from (the rescue root's
# /etc/pedal-image has the commits only: it boots neither).
{ echo "pedal-kernel=$PEDAL_KERNEL"
  echo "fallback-kernel=$FALLBACK_KERNEL"
  echo "kernel-kind=${PIN[kernel-kind]:-}"
  echo "kernel-rtpi=${PIN[kernel-rtpi]:-}"; } >> "$PEDAL/etc/pedal-image"

log "pedal root: namchain $NC_SHORT into /opt/namchain"
nc=/opt/namchain/$NC_SHORT
install -d "$PEDAL$nc/bin" "$PEDAL$nc/packaging"
for b in namchaind namchainctl namchain-soak namchain-latency namchain-render; do
  install -m 755 "$W/namchain-src/build/$b" "$PEDAL$nc/bin/$b"
done
install -m 644 "$W/namchain-src/packaging/systemd/namchaind.service" "$PEDAL$nc/packaging/"
printf 'commit=%s\nrev=%s\nbuilt=%s\nhost=%s\nkernel=%s\n' "$NC_COMMIT" "image" \
  "$(date -u -d "@$SOURCE_DATE_EPOCH" +%FT%TZ)" "build container (resolute $SNAPSHOT)" "$PEDAL_KERNEL" \
  > "$PEDAL$nc/MANIFEST"
ln -sfn "$nc" "$PEDAL/opt/namchain/current"
install -m 644 "$W/namchain-src/packaging/systemd/namchaind.service" "$PEDAL/etc/systemd/system/namchaind.service"
install -d -m 755 "$PEDAL/etc/namchain"
(umask 077; printf '%s\n' "$TOKEN" > "$PEDAL/etc/namchain/token")
missing=$(chroot "$PEDAL" ldd "$nc/bin/namchaind" | grep 'not found' || true)
[[ -z $missing ]] || die "namchaind's libraries aren't in the pedal root: $missing"

log "pedal root: devices/common + devices/$HOST, applied offline"
S=$W/stage
mkdir -p "$S/rootfs"
cp -a "$IN/pedal/devices/common/rootfs/." "$S/rootfs/"
cp -a "$DEV/rootfs/." "$S/rootfs/"
bash "$S/rootfs/usr/local/sbin/pedal-device" apply "$S" --root "$PEDAL" --commit "${PIN[pedal]:0:7}" >&2
chroot "$PEDAL" systemctl enable -q namchaind vip-boot-settle vip-boot-validate pedal-guard pedal-guard-maint vip-boot-deadline

log "pedal root: initramfs for both kernels, with vip-guard"
initramfs "$PEDAL" "$FALLBACK_KERNEL"      # the pedal kernel's came from vip-install-kernel
for rel in "$PEDAL_KERNEL" "$FALLBACK_KERNEL"; do
  chroot "$PEDAL" lsinitrd "/boot/initrd.img-$rel" > "$W/initrd-$rel.txt"
  grep -q 'vip-guard\.sh' "$W/initrd-$rel.txt" \
    || die "vip-guard isn't in the $rel initramfs: a boot of that slot would never count"
done

log "rescue root: customise"
common "$RESCUE" rescue
cat > "$RESCUE/etc/fstab" <<EOF
# The rescue root is read-only (docs/vip-image.md, "Two roots"): what changes lives in RAM.
LABEL=$RESCUE_ROOT_LABEL  /                  ext4   ro,noatime             0 1
tmpfs          /tmp               tmpfs  mode=1777,nosuid,nodev 0 0
tmpfs          /var/tmp           tmpfs  mode=1777,nosuid,nodev 0 0
tmpfs          /var/log           tmpfs  mode=0755,nosuid,nodev 0 0
tmpfs          /var/lib/systemd   tmpfs  mode=0755,nosuid,nodev 0 0
tmpfs          /var/lib/sudo      tmpfs  mode=0711,nosuid,nodev 0 0
LABEL=$BOOTSEL_LABEL     $BOOTSEL_MOUNT      vfat  defaults,noauto,nofail  0 0
EOF
install -d "$RESCUE/mnt/pedal" "$RESCUE/mnt/pedal-data" "$RESCUE/mnt/pedal-boot" "$RESCUE$PEDAL_BOOT_MOUNT"
# Restoring the pedal root from its image on pedal-data (rtpi).
install -D -m 755 "$RTPI_DEV/usr/local/sbin/vip-reimage" "$RESCUE/usr/local/sbin/vip-reimage"
install -D -m 644 /dev/stdin "$RESCUE/etc/systemd/journald.conf.d/10-rescue.conf" <<'EOF'
# The root is read-only: the journal lives in RAM.
[Journal]
Storage=volatile
EOF
# No password anywhere, so a keyboard on HDMI, or the Debug Probe on the UART header, gets a
# root shell in rescue without one: whoever holds the board can take the card out anyway.
for t in getty@tty1 serial-getty@ttyAMA10; do
  install -D -m 644 /dev/stdin "$RESCUE/etc/systemd/system/$t.service.d/10-autologin.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,57600,38400,9600 %I $TERM
EOF
done
install -D -m 755 /dev/stdin "$RESCUE/etc/profile.d/90-rescue.sh" <<'EOF'
# Say where you are: this is the rescue root, not the pedal.
if [ -t 1 ]; then
  printf '\n  \033[1;33mvip RESCUE root\033[0m (read-only). The pedal root is on LABEL=pedal: mount it on /mnt/pedal.\n'
  printf '  vip-boot status; vip-boot default pedal to go back.\n\n'
  vip-boot status 2>/dev/null | sed 's/^/  /'
fi
PS1='\[\033[1;33m\]\u@\h(rescue)\[\033[0m\]:\w\$ '
EOF
log "rescue root: initramfs"
initramfs "$RESCUE" "$RESCUE_KERNEL"

# ------------------------------------------------------------------ boot partitions
log "boot partitions (rtpi's vip-boot init-*)"
VB=(python3 "$RTPI_DEV/usr/local/sbin/vip-boot" --env "$RTPI_DEV/device.env")
"${VB[@]}" init-bootsel --dir "$W/p1"
"${VB[@]}" init-pedal-boot --dir "$W/p2" --kernel-root "$PEDAL" --release "$PEDAL_KERNEL" \
  --fallback-release "$FALLBACK_KERNEL" --config-extra "$DEV/config-pedal.txt"
"${VB[@]}" init-rescue-boot --dir "$W/p3" --kernel-root "$RESCUE" --release "$RESCUE_KERNEL" --config-extra "$DEV/config-rescue.txt"

# ------------------------------------------------------------------ the tree record
# Every path in a tree: type, mode, owner, size, link target, content hash (not for secrets).
tree() {  # tree <dir> <out>
  python3 - "$1" "$SECRET_PATHS" > "$2" <<'PY'
import hashlib, os, re, stat, sys
top, secret = sys.argv[1], re.compile(sys.argv[2])
out = []
for d, dirs, files in os.walk(top):
    dirs.sort()
    for n in sorted(dirs + files):
        full = os.path.join(d, n); rel = os.path.relpath(full, top); st = os.lstat(full)
        m = st.st_mode
        if stat.S_ISLNK(m):   out.append(f"l {rel} -> {os.readlink(full)}")
        elif stat.S_ISDIR(m): out.append(f"d {rel} {m & 0o7777:o} {st.st_uid}:{st.st_gid}")
        elif stat.S_ISREG(m):
            if secret.match(rel): h = "secret"
            else:
                h = hashlib.sha256()
                with open(full, "rb") as f:
                    for b in iter(lambda: f.read(1 << 20), b""): h.update(b)
                h = h.hexdigest()
            out.append(f"f {rel} {m & 0o7777:o} {st.st_uid}:{st.st_gid} {st.st_size} {h}")
        else: out.append(f"{'c' if stat.S_ISCHR(m) else 'b' if stat.S_ISBLK(m) else 'p' if stat.S_ISFIFO(m) else 's'} {rel} {m & 0o7777:o}")
print("\n".join(out))
PY
}

# ------------------------------------------------------------------ filesystems
log "pedal-data: /var/lib/pedal, and the pedal root's image for rescue to restore"
mkdir -p "$DATA/images"
cp -a "$PEDAL/var/lib/pedal/." "$DATA/"
find "$PEDAL/var/lib/pedal" -mindepth 1 -delete
chroot "$PEDAL"  dpkg-query -W -f='${Package} ${Version}\n' > "$OUT/packages-pedal.txt"
chroot "$RESCUE" dpkg-query -W -f='${Package} ${Version}\n' > "$OUT/packages-rescue.txt"

# Every file at one time, so the FAT and ext4 images don't carry the build's clock.
for d in "$PEDAL" "$RESCUE" "$DATA" "$W/p1" "$W/p2" "$W/p3"; do
  find "$d" -xdev -newermt "@$SOURCE_DATE_EPOCH" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +
done
tree "$PEDAL" "$OUT/tree-pedal.txt"; tree "$RESCUE" "$OUT/tree-rescue.txt"
tree "$W/p1" "$OUT/tree-bootsel.txt"; tree "$W/p2" "$OUT/tree-pedal-boot.txt"; tree "$W/p3" "$OUT/tree-rescue-boot.txt"

mkext4() {  # mkext4 <dir> <label> <MiB> <out>
  local used; used=$(du -sm "$1" | cut -f1)
  (( used * 12 / 10 + 64 < $3 )) || die "$2: $used MiB doesn't fit in $3 MiB"
  rm -f "$4"
  mkfs.ext4 -q -L "$2" -U "$(uuid "fs-$2")" -E root_owner=0:0,hash_seed="$(uuid "hash-$2")" -d "$1" "$4" "${3}M"
}
mkfat() {  # mkfat <dir> <label> <MiB> <out> <volume id>
  rm -f "$4"; mkfs.vfat -F 32 -n "$2" -i "$5" -C "$4" $(( $3 * 1024 )) >/dev/null
  MTOOLS_SKIP_CHECK=1 mcopy -s -m -i "$4" "$1"/* ::/
}
log "filesystems"
mkfat "$W/p1" "$BOOTSEL_LABEL" "$BOOTSEL_MB" "$W/p1.img" 7669700a
mkfat "$W/p2" "$PEDAL_BOOT_LABEL" "$PEDAL_BOOT_MB" "$W/p2.img" 7669700b
mkfat "$W/p3" "$RESCUE_BOOT_LABEL" "$RESCUE_BOOT_MB" "$W/p3.img" 7669700c
mkext4 "$RESCUE" "$RESCUE_ROOT_LABEL" "$RESCUE_ROOT_MB" "$W/p4.img"
mkext4 "$PEDAL" "$PEDAL_ROOT_LABEL" "$PEDAL_ROOT_MB" "$W/p5.img"
zstd -q -T0 -10 "$W/p5.img" -o "$DATA/images/pedal-root.ext4.zst"
sha256sum "$W/p5.img" | sed "s|$W/p5.img|pedal-root.ext4|" > "$DATA/images/pedal-root.ext4.sha256"
touch -h -d "@$SOURCE_DATE_EPOCH" "$DATA/images" "$DATA/images"/*
# Also beside the card image: make-card --remote sends it to a running vip.
cp "$DATA/images/pedal-root.ext4.zst" "$DATA/images/pedal-root.ext4.sha256" "$OUT/"
tree "$DATA" "$OUT/tree-pedal-data.txt"
DATA_MB=$(( $(du -sm "$DATA" | cut -f1) * 12 / 10 + 128 ))
mkext4 "$DATA" pedal-data "$DATA_MB" "$W/p6.img"

# ------------------------------------------------------------------ the card
log "card image"
IMG=$OUT/$HOST.img
MB=$(( 1 + BOOTSEL_MB + PEDAL_BOOT_MB + RESCUE_BOOT_MB + RESCUE_ROOT_MB + PEDAL_ROOT_MB + DATA_MB + 1 ))
rm -f "$IMG"; truncate -s "${MB}M" "$IMG"
BASIC=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7
ROOT64=B921B045-1DF0-41C3-AF44-4C6F280D3FAE
LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
sfdisk -q "$IMG" <<EOF
label: gpt
label-id: $(uuid disk)
first-lba: 2048
start=1MiB, size=${BOOTSEL_MB}MiB,     type=$BASIC,  uuid=$(uuid part-bootsel),     name=bootsel
            size=${PEDAL_BOOT_MB}MiB,  type=$BASIC,  uuid=$(uuid part-pedal-boot),  name=pedal-boot
            size=${RESCUE_BOOT_MB}MiB, type=$BASIC,  uuid=$(uuid part-rescue-boot), name=rescue-boot
            size=${RESCUE_ROOT_MB}MiB, type=$ROOT64, uuid=$(uuid part-rescue),      name=rescue
            size=${PEDAL_ROOT_MB}MiB,  type=$ROOT64, uuid=$(uuid part-pedal),       name=pedal
            size=${DATA_MB}MiB,        type=$LINUX,  uuid=$(uuid part-pedal-data),  name=pedal-data
EOF
n=0
while read -r start; do
  n=$(( n + 1 ))
  dd if="$W/p$n.img" of="$IMG" bs=1M seek=$(( start * 512 / 1048576 )) conv=notrunc,sparse status=none
done < <(sfdisk -J "$IMG" | python3 -c 'import json,sys; [print(p["start"]) for p in json.load(sys.stdin)["partitiontable"]["partitions"]]')

{
  echo "host $HOST"
  for k in pedal rtpi namchain snapshot; do echo "$k ${PIN[$k]}"; done
  echo "pedal-kernel $PEDAL_KERNEL"
  echo "fallback-kernel $FALLBACK_KERNEL"
  echo "rescue-kernel $RESCUE_KERNEL"
  echo "kernel-kind ${PIN[kernel-kind]:-}"
  echo "kernel-rtpi ${PIN[kernel-rtpi]:-}"
  echo "kernel-boot-sha256 ${PIN[kernel-boot-sha256]:-}"
  echo "kernel-modules-sha256 ${PIN[kernel-modules-sha256]:-}"
  echo "kernel-dtb-sha256 ${PIN[kernel-dtb-sha256]:-}"
  # What each slot's kernel is, byte for byte: `--remote` refuses to write a root under a slot
  # whose kernel is not this (image/remote), because the FAT slot is the one thing a root swap
  # cannot move.
  echo "pedal-kernel-vmlinuz $PEDAL_VMLINUZ_SHA"
  echo "fallback-kernel-vmlinuz $FALLBACK_VMLINUZ_SHA"
  echo "image-bytes $(stat -c %s "$IMG")"
  echo "image-sha256 $(sha256sum "$IMG" | cut -d' ' -f1)"
  for t in pedal rescue; do echo "packages-$t $(sha256sum < "$OUT/packages-$t.txt" | cut -d' ' -f1) $(wc -l < "$OUT/packages-$t.txt")"; done
  for t in bootsel pedal-boot rescue-boot rescue pedal pedal-data; do
    echo "tree-$t $(sha256sum < "$OUT/tree-$t.txt" | cut -d' ' -f1) $(wc -l < "$OUT/tree-$t.txt")"
  done
  echo "--- sfdisk"
  sfdisk -d "$IMG" | sed "s|$OUT/||"
} > "$OUT/manifest"
log "done: $(du -h --apparent-size "$IMG" | cut -f1) ($(du -h "$IMG" | cut -f1) on disk) $IMG"
