#!/usr/bin/env bash
# devices/<host>/check — is the host running exactly this tree, and is it all in force? Read-only.
#
# Compares every file under both rootfs/ trees with the copy on the host, checks that the packages
# in devices/<host>/packages (if it has one) are installed, then runs
# `pedal-device status`, which checks the masks, the clock, the cpusets, the audio interrupt and what may run on core 3.
# Exits non-zero on any difference.

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
require_dev

bad=0
log "files: devices/common + devices/$DEV_NAME rootfs against $DEV_HOST"
local_sums=$(while IFS=$'\t' read -r src dst; do
  printf '%s  %s\n' "$(shasum -a 256 "$src" | cut -d' ' -f1)" "$dst"; done < <(rootfs_files))
files=$(cut -d' ' -f3 <<< "$local_sums" | tr '\n' ' ')
remote_sums=$(dev "sudo -n sha256sum $files 2>/dev/null" || true)
while read -r sum path; do
  theirs=$(awk -v p="$path" '$2 == p { print $1 }' <<< "$remote_sums")
  if [[ -z $theirs ]]; then printf '  FAIL  %-50s missing on %s\n' "$path" "$DEV_HOST"; bad=1
  elif [[ $theirs != "$sum" ]]; then printf '  FAIL  %-50s differs from the repo\n' "$path"; bad=1
  else printf '  ok    %s\n' "$path"; fi
done <<< "$local_sums"

if [[ -f $DEV_DIR/packages ]]; then
  log "packages: devices/$DEV_NAME/packages on $DEV_HOST"
  pkgs=$(grep -v -e '^#' -e '^[[:space:]]*$' "$DEV_DIR/packages" | tr '\n' ' ')
  installed=$(dev "dpkg-query -W -f='\${Package} \${db:Status-Abbrev}\n' $pkgs 2>/dev/null" || true)
  for p in $pkgs; do
    if awk -v p="$p" '$1 == p && $2 == "ii" { f = 1 } END { exit !f }' <<< "$installed"; then
      printf '  ok    %s\n' "$p"
    else printf '  FAIL  %-50s not installed on %s\n' "$p" "$DEV_HOST"; bad=1; fi
  done
fi

if [[ -f $DEV_DIR/authorized_keys ]]; then
  log "login keys: devices/$DEV_NAME/authorized_keys on $DEV_HOST"
  user=$(sed -n 's/^USER_NAME=//p' "$DEV_DIR/image.env" 2>/dev/null || true)
  if [[ -z $user ]]; then
    printf '  --    %-50s %s\n' "login keys" "no USER_NAME in devices/$DEV_NAME/image.env"
  else
    want=$(shasum -a 256 "$DEV_DIR/authorized_keys" | cut -d' ' -f1)
    got=$(dev "sha256sum /home/$user/.ssh/authorized_keys 2>/dev/null" | cut -d' ' -f1 || true)
    if [[ $got == "$want" ]]; then printf '  ok    %s\n' "/home/$user/.ssh/authorized_keys"
    else printf '  FAIL  %-50s differs from devices/%s/authorized_keys\n' "/home/$user/.ssh/authorized_keys" "$DEV_NAME"; bad=1; fi
  fi
fi

# The two kernels: the pedal's (rtpi's rebuild, installed from the image's artefacts) in slot a,
# the stock one the spare slot boots in slot b, and both of them in the root so either slot can
# boot against it (docs/vip-kernel-image.md). Read from the host's own device.env: this is about
# what the board carries, not about what the repo would build.
pedal_kernel=$(dev 'sed -n "s/^PEDAL_KERNEL=//p" /etc/rtpi/device.env' 2>/dev/null || true)
fallback_kernel=$(dev 'sed -n "s/^FALLBACK_KERNEL=//p" /etc/rtpi/device.env' 2>/dev/null || true)
if [[ -z $pedal_kernel || -z $fallback_kernel ]]; then
  log "kernels: $DEV_HOST's /etc/rtpi/device.env names one kernel"
  printf '  --    %-50s %s\n' "pedal and fallback kernels" \
    "PEDAL_KERNEL='$pedal_kernel' FALLBACK_KERNEL='$fallback_kernel'"
else
  log "kernels: $pedal_kernel (slot a) and $fallback_kernel (slot b) on $DEV_HOST"
  status=$(dev "sudo -n vip-boot status" 2>/dev/null || true)
  for pair in "a:$pedal_kernel" "b:$fallback_kernel"; do
    s=${pair%%:*}; rel=${pair#*:}
    line=$(awk -v s="$s" '$1 == "slot" && $2 == s' <<< "$status")
    read -ra fields <<< "$line"
    good=0; named=0
    for f in "${fields[@]}"; do
      [[ $f == good ]] && good=1
      [[ $f == "$rel" ]] && named=1
    done
    if (( good && named )); then printf '  ok    %s\n' "slot $s: $rel, good"
    else printf '  FAIL  %-50s\n' "slot $s is not $rel, good"; bad=1; fi
    have=$(dev "ls -d /lib/modules/$rel /boot/vmlinuz-$rel /boot/initrd.img-$rel 2>/dev/null | wc -l")
    if [[ $have == 3 ]]; then printf '  ok    %s\n' "$rel: modules, kernel and initramfs in the root"
    else printf '  FAIL  %-50s %s\n' "$rel" "only $have of 3 in the root"; bad=1; fi
  done
fi

log "state on $DEV_HOST"
dev "sudo -n /usr/local/sbin/pedal-device status" || bad=1
printf '  --    %-34s %s\n' "repo tree" "$(tree_commit)"

(( bad == 0 )) && ok "$DEV_HOST matches devices/$DEV_NAME and it is in force" || { warn "$DEV_HOST differs; see FAIL lines"; exit 1; }
