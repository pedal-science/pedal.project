#!/usr/bin/env bash
# devices/<host>/check — is the host running exactly this tree, and is it all in force? Read-only.
#
# Compares every file under both rootfs/ trees with the copy on the host, checks that the packages
# in devices/<host>/packages (if it has one) are installed, then runs
# `pedal-device status`, which checks the masks, the clock, the cpusets, the audio interrupt and what may run on core 3.
# Exits non-zero on any difference.

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
require_dev

bad=0
log "files: devices/common + devices/$DEV_NAME rootfs against $DEV_HOST"
local_sums=$(while IFS=$'\t' read -r src dst; do
  printf '%s  %s\n' "$(shasum -a 256 "$src" | cut -d' ' -f1)" "$dst"; done < <(rootfs_files))
files=$(cut -d' ' -f3 <<< "$local_sums" | tr '\n' ' ')
remote_sums=$(dev "sudo -n sha256sum $files 2>/dev/null" || true)
while read -r sum path; do
  theirs=$(awk -v p="$path" '$2 == p { print $1 }' <<< "$remote_sums")
  if [[ -z $theirs ]]; then printf '  FAIL  %-50s missing on %s\n' "$path" "$DEV_HOST"; bad=1
  elif [[ $theirs != "$sum" ]]; then printf '  FAIL  %-50s differs from the repo\n' "$path"; bad=1
  else printf '  ok    %s\n' "$path"; fi
done <<< "$local_sums"

if [[ -f $DEV_DIR/packages ]]; then
  log "packages: devices/$DEV_NAME/packages on $DEV_HOST"
  pkgs=$(grep -v -e '^#' -e '^[[:space:]]*$' "$DEV_DIR/packages" | tr '\n' ' ')
  installed=$(dev "dpkg-query -W -f='\${Package} \${db:Status-Abbrev}\n' $pkgs 2>/dev/null" || true)
  for p in $pkgs; do
    if awk -v p="$p" '$1 == p && $2 == "ii" { f = 1 } END { exit !f }' <<< "$installed"; then
      printf '  ok    %s\n' "$p"
    else printf '  FAIL  %-50s not installed on %s\n' "$p" "$DEV_HOST"; bad=1; fi
  done
fi

if [[ -f $DEV_DIR/authorized_keys ]]; then
  log "login keys: devices/$DEV_NAME/authorized_keys on $DEV_HOST"
  user=$(sed -n 's/^USER_NAME=//p' "$DEV_DIR/image.env" 2>/dev/null || true)
  if [[ -z $user ]]; then
    printf '  --    %-50s %s\n' "login keys" "no USER_NAME in devices/$DEV_NAME/image.env"
  else
    want=$(shasum -a 256 "$DEV_DIR/authorized_keys" | cut -d' ' -f1)
    got=$(dev "sha256sum /home/$user/.ssh/authorized_keys 2>/dev/null" | cut -d' ' -f1 || true)
    if [[ $got == "$want" ]]; then printf '  ok    %s\n' "/home/$user/.ssh/authorized_keys"
    else printf '  FAIL  %-50s differs from devices/%s/authorized_keys\n' "/home/$user/.ssh/authorized_keys" "$DEV_NAME"; bad=1; fi
  fi
fi

# The two kernels: the pedal's (rtpi's rebuild, installed from the image's artefacts) in the active
# slot, the stock one in the other, and both of them in the root so either slot can boot against it
# (docs/vip-kernel-image.md). By role, not by letter: every validated trial (try-kernel, try-args,
# try-config) promotes the spare slot, so which letter holds which kernel moves; what must hold is that
# the pedal boots its own kernel and has the stock one to fall back to. Read from the host's own
# device.env: this is about what the board carries, not about what the repo would build.
pedal_kernel=$(dev 'sed -n "s/^PEDAL_KERNEL=//p" /etc/rtpi/device.env' 2>/dev/null || true)
fallback_kernel=$(dev 'sed -n "s/^FALLBACK_KERNEL=//p" /etc/rtpi/device.env' 2>/dev/null || true)
if [[ -z $pedal_kernel || -z $fallback_kernel ]]; then
  log "kernels: $DEV_HOST's /etc/rtpi/device.env names one kernel"
  printf '  --    %-50s %s\n' "pedal and fallback kernels" \
    "PEDAL_KERNEL='$pedal_kernel' FALLBACK_KERNEL='$fallback_kernel'"
else
  log "kernels: $pedal_kernel (active) and $fallback_kernel (fallback) on $DEV_HOST"
  status=$(dev "sudo -n vip-boot status" 2>/dev/null || true)
  # "slot a *   good  <release>  <args>": the star marks the active slot.
  active=$(awk '$1 == "slot" && $3 == "*" {print $2}' <<< "$status")
  spare=$(awk '$1 == "slot" && $3 != "*" {print $2}' <<< "$status")
  for pair in "$active:$pedal_kernel:active" "$spare:$fallback_kernel:fallback"; do
    IFS=: read -r s rel role <<< "$pair"
    line=$(awk -v s="$s" '$1 == "slot" && $2 == s' <<< "$status")
    read -ra fields <<< "$line"
    good=0; named=0
    for f in "${fields[@]}"; do
      [[ $f == good ]] && good=1
      [[ $f == "$rel" ]] && named=1
    done
    if [[ -n $s ]] && (( good && named )); then printf '  ok    %s\n' "$role slot ($s): $rel, good"
    else printf '  FAIL  %-50s\n' "the $role slot (${s:-none}) is not $rel, good"; bad=1; fi
    have=$(dev "ls -d /lib/modules/$rel /boot/vmlinuz-$rel /boot/initrd.img-$rel 2>/dev/null | wc -l")
    if [[ $have == 3 ]]; then printf '  ok    %s\n' "$rel: modules, kernel and initramfs in the root"
    else printf '  FAIL  %-50s %s\n' "$rel" "only $have of 3 in the root"; bad=1; fi
  done
fi

# The bootloader EEPROM: what it runs and how it is configured is boot behaviour, and the pinned
# image tree is what a future update installs from. Nothing in devices/ owned either until now
# (docs/vip-image.md, "The bootloader EEPROM"). The image files are deliberately not in git, so an
# absent tree is reported rather than failed: eeprom-fetch puts it back from eeprom.lock.
lock="$DEV_DIR/rootfs/usr/local/lib/rpi-eeprom/eeprom.lock"
if [[ -f $lock ]]; then
  log "bootloader EEPROM: eeprom.lock against what $DEV_HOST carries"
  # shellcheck disable=SC1090
  . "$lock"
  live_ver=$(dev "tr -d '\\0' < /proc/device-tree/chosen/bootloader/version" 2>/dev/null | cut -c1-8)
  live_ts=$(dev "od -An -tu4 --endian=big /proc/device-tree/chosen/bootloader/build-timestamp" 2>/dev/null | tr -d ' ')
  if [[ $live_ver == "$EEPROM_VERSION" && $live_ts == "$EEPROM_TIMESTAMP" ]]; then
    printf '  ok    %s\n' "version $live_ver, built $EEPROM_DATE"
  else
    printf '  FAIL  %-50s %s\n' "version $live_ver (${live_ts:-?}), eeprom.lock says $EEPROM_VERSION ($EEPROM_TIMESTAMP)" \
      "the board is not on the recorded bootloader: see docs/vip-image.md"
    bad=1
  fi
  live_cfg=$(dev "sudo -n vcgencmd bootloader_config" 2>/dev/null || true)
  cfg_bad=""
  for pair in "BOOT_UART:$EEPROM_CONFIG_BOOT_UART" "BOOT_ORDER:$EEPROM_CONFIG_BOOT_ORDER" \
              "NET_INSTALL_AT_POWER_ON:$EEPROM_CONFIG_NET_INSTALL_AT_POWER_ON"; do
    k=${pair%%:*}; want=${pair#*:}
    got=$(awk -F= -v k="$k" '$1 == k { print $2 }' <<< "$live_cfg")
    [[ $got == "$want" ]] || cfg_bad+=" $k=$got(want $want)"
  done
  if [[ -z $cfg_bad ]]; then
    printf '  ok    %s\n' "config $EEPROM_CONFIG_BOOT_UART/$EEPROM_CONFIG_BOOT_ORDER/$EEPROM_CONFIG_NET_INSTALL_AT_POWER_ON"
  else
    printf '  FAIL  %-50s%s\n' "config differs from eeprom.lock" "$cfg_bad"; bad=1
  fi
  tree_hashes=$(dev "sha256sum $EEPROM_DIR-2712/$EEPROM_RELEASE/$EEPROM_IMAGE \
                     $EEPROM_DIR-2712/$EEPROM_RELEASE/recovery.bin 2>/dev/null" || true)
  if [[ -z $tree_hashes ]]; then
    printf '  --    %-50s %s\n' "pinned image tree" "not installed; devices/vip/eeprom-fetch puts it there"
  else
    for pair in "$EEPROM_IMAGE:$EEPROM_IMAGE_SHA256" "recovery.bin:$EEPROM_RECOVERY_SHA256"; do
      f=${pair%%:*}; want=${pair#*:}
      got=$(awk -v f="$f" '$2 ~ "/" f "$" { print $1 }' <<< "$tree_hashes")
      if [[ $got == "$want" ]]; then printf '  ok    %s\n' "pinned $f"
      else printf '  FAIL  %-50s %s\n' "pinned $f" "sha256 ${got:-missing} is not eeprom.lock's"; bad=1; fi
    done
  fi
fi

# The cost table: this device's own numbers, measured on this device, and the provenance they were
# taken with (P2 of docs/managing-processing-power-and-optimising-for-fast-switching.md). A table
# measured against another engine or another kernel is not this device's table, and a table that is
# not there is a device nobody has measured -- the engine still plays, charging every unit its unknown
# cost (D8), which is why this is the check that says so.
cost="$DEV_DIR/rootfs/etc/namchain/cost.json"
if [[ -f $cost ]]; then
  log "cost table: devices/$DEV_NAME against what $DEV_HOST runs"
  engine_rev=$(dev "sed -n 's/^rev=//p' /opt/namchain/current/MANIFEST 2>/dev/null" | tr -d '[:space:]' || true)
  kernel=$(dev "uname -r" | tr -d '[:space:]' || true)
  "$COMMON_DIR/cost-check" "$cost" --host "$DEV_NAME" --engine-commit "$engine_rev" --kernel "$kernel" || bad=1
else
  printf '  FAIL  %-50s %s\n' "cost.json" "missing: devices/$DEV_NAME/rootfs/etc/namchain/cost.json"; bad=1
fi

log "state on $DEV_HOST"
dev "sudo -n /usr/local/sbin/pedal-device status" || bad=1
printf '  --    %-34s %s\n' "repo tree" "$(tree_commit)"

(( bad == 0 )) && ok "$DEV_HOST matches devices/$DEV_NAME and it is in force" || { warn "$DEV_HOST differs; see FAIL lines"; exit 1; }
