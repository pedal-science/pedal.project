#!/usr/bin/env bash
# devices/<host>/make-card — build a Pi host's card image on the Mac and write it to a blank card.
#
#   devices/vip/make-card [--image-only] [--disk /dev/diskN] [--dev]
#   devices/vip/make-card --remote [--dev]           build, then put the pedal root on the running vip
#   devices/vip/make-card --remote --image DIR       put an image built before on it (no build)
#   devices/vip/make-card --remote --previous --image DIR   back to the root before the last one sent
#   devices/vip/make-card --lock          pin image.lock to the three repos' HEADs
#
# docs/vip-image.md is the design. Everything is built in colima's aarch64 container
# (devices/common/image): namchain from its commit, tested; the pedal root and the rescue root
# from the Ubuntu snapshot; the boot partitions by rtpi's vip-boot; one GPT image. The inputs are
# exported with `git archive` at the commits in devices/<host>/image.lock, never taken from a
# working tree: --dev takes the working trees instead, uncommitted changes and all, and marks the
# image -dirty.
#
# Secrets come from 1Password (image.env names the vault and items), read with the service
# account's token from the login keychain, and go to the container on stdin: never a file on the
# Mac, never shown. The first build makes the host's SSH key item.
#
# Output: build/<host>/<stamp>/ (gitignored): the image, its manifest, the package lists and the
# file trees. The manifest is also copied to devices/<host>/images/<stamp>.manifest, to commit.
# Then, unless --image-only, devices/common/write-card writes the card (it asks first).
#
# --remote writes no card: it puts the new pedal root on vip through its rescue root, tries it as
# a candidate, and makes it the default only once it runs (devices/common/image/remote, step 7 of
# docs/vip-image.md). The rescue root and the boot partitions stay as the card has them.

set -euo pipefail
log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }

HERE=$(cd "$(dirname "$0")" && pwd)          # devices/<host>, through the link
HOST=$(basename "$HERE")
REPO=$(git -C "$HERE" rev-parse --show-toplevel)
COMMON=$REPO/devices/common
RTPI_REPO=${RTPI_REPO:-$HOME/code.local/rtpi}
NAMCHAIN_REPO=${NAMCHAIN_REPO:-$HOME/code.local/namchain}
LOCK=$HERE/image.lock

IMAGE_ONLY=0; DISK=(); DEV=0; DO_LOCK=0; REMOTE=0; PREVIOUS=0; FROM=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --image-only) IMAGE_ONLY=1 ;;
    --disk) DISK=(--disk "$2"); shift ;;
    --dev) DEV=1 ;;
    --lock) DO_LOCK=1 ;;
    --remote) REMOTE=1 ;;
    --previous) PREVIOUS=1 ;;
    --image) FROM=$(cd "$2" && pwd) || die "no $2"; shift ;;
    -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done
[[ -f $HERE/image.env ]] || die "no $HERE/image.env: $HOST isn't built from an image"
(( PREVIOUS && ! REMOTE )) && die "--previous goes with --remote"
[[ -n $FROM && $REMOTE -eq 0 ]] && die "--image goes with --remote"
(( PREVIOUS )) && [[ -z $FROM ]] && die "--previous needs --image DIR (a build, for the tools it sends to rescue)"
if [[ -n $FROM ]]; then
  exec "$COMMON/image/remote" "$FROM" "$HOST" $( ((PREVIOUS)) && echo --previous)
fi
# shellcheck disable=SC1091
source "$HERE/image.env"

declare -A REPOS=([pedal]=$REPO [rtpi]=$RTPI_REPO [namchain]=$NAMCHAIN_REPO)
lock_get() { sed -n "s/^$1=//p" "$LOCK"; }

if (( DO_LOCK )); then
  snap=$(lock_get snapshot)
  # The kernel block is not a commit: it stays as it is, comments and all, and is re-emitted
  # verbatim below (docs/vip-kernel-image.md).
  keep=$(sed -n '/^# The pedal kernel:/,$p' "$LOCK")
  {
    echo "# What devices/$HOST/make-card builds from (docs/vip-image.md). --lock rewrites the commits;"
    echo "# the snapshot and the kernel change by hand, deliberately. Check namchain is the engine you"
    echo "# mean, and that the kernel is the rebuild you mean (docs/vip-kernel-image.md)."
    echo "snapshot=${snap:?no snapshot in $LOCK}"
    for k in pedal rtpi namchain; do echo "$k=$(git -C "${REPOS[$k]}" rev-parse HEAD)"; done
    [[ -z $keep ]] || { echo; printf '%s\n' "$keep"; }
  } > "$LOCK.new"
  mv "$LOCK.new" "$LOCK"
  cat "$LOCK"; exit 0
fi

# ------------------------------------------------------------------ checks, before any time is spent
docker info >/dev/null 2>&1 || die "no docker: start colima (colima start --arch aarch64 --vm-type vz)"
[[ $(docker info --format '{{.Architecture}}') == aarch64 ]] || die "the docker host is not aarch64"
# A build writes about 10 GB inside colima, whose disk file on the Mac only shrinks when the VM
# trims it; the first builds filled the Mac's disk (2026-09-30).
free_gb=$(df -g "$REPO" | awk 'NR==2 {print $4}')
(( free_gb >= 15 )) || die "only $free_gb GB free on the Mac: a build needs 15 (colima's disk grows while it runs)"
command -v op >/dev/null || die "no op (1Password CLI)"
OP_SERVICE_ACCOUNT_TOKEN=$(security find-generic-password -l "$OP_KEYCHAIN_LABEL" -w 2>/dev/null) \
  || die "no keychain item '$OP_KEYCHAIN_LABEL' with the 1Password service account token"
export OP_SERVICE_ACCOUNT_TOKEN
op vault get "$OP_VAULT" >/dev/null 2>&1 || die "the service account can't read vault $OP_VAULT"
for item in "$WIFI_ITEM" "$TOKEN_ITEM"; do
  op item get "$item" --vault "$OP_VAULT" >/dev/null 2>&1 || die "no item '$item' in vault $OP_VAULT"
done
if ! op item get "$HOST_KEY_ITEM" --vault "$OP_VAULT" >/dev/null 2>&1; then
  log "first build for $HOST: making its SSH host key in 1Password ($OP_VAULT/$HOST_KEY_ITEM)"
  op item create --vault "$OP_VAULT" --category "SSH Key" --title "$HOST_KEY_ITEM" \
    --ssh-generate-key ed25519 "notesPlain=$HOST's SSH host key: both roots of its card (devices/$HOST/make-card)." >/dev/null
fi
# The login keys: devices/<host>/authorized_keys is the record, installed verbatim in both roots
# (docs/vip-image.md, "The build"). Without it, take them from the SSH agent and say so: that
# input isn't in the repo, so a rebuild can't reproduce it.
if [[ -f $HERE/authorized_keys ]]; then
  grep -q -v -e '^#' -e '^[[:space:]]*$' "$HERE/authorized_keys" || die "$HERE/authorized_keys holds no keys"
  AUTH_KEYS=$(cat "$HERE/authorized_keys")
  log "login keys: devices/$HOST/authorized_keys ($(grep -c -v -e '^#' -e '^[[:space:]]*$' "$HERE/authorized_keys") key(s))"
else
  warn "no devices/$HOST/authorized_keys: the login keys come from ssh-add -L, unrecorded"
  AUTH_KEYS=$(ssh-add -L 2>/dev/null) && [[ -n $AUTH_KEYS ]] || die "no login keys: neither devices/$HOST/authorized_keys nor ssh-add -L has any"
fi

# ------------------------------------------------------------------ inputs
declare -A PIN
if (( DEV )); then
  for k in pedal rtpi namchain; do PIN[$k]=$(git -C "${REPOS[$k]}" rev-parse HEAD); done
  PIN[snapshot]=$(lock_get snapshot)
else
  [[ -f $LOCK ]] || die "no $LOCK: run --lock, commit it, or build with --dev"
  for k in snapshot pedal rtpi namchain; do PIN[$k]=$(lock_get "$k"); [[ -n ${PIN[$k]} ]] || die "no $k in $LOCK"; done
fi
# The pedal kernel is artefacts, not a tree, so both paths take it from the lock: --dev means the
# working trees of the three repos, not a working directory full of kernel build output.
for k in kernel kernel-kind kernel-rtpi kernel-boot-sha256 kernel-modules-sha256 kernel-dtb-sha256; do
  PIN[$k]=$(lock_get "$k")
done
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
# --dev: each repo with uncommitted changes is marked -dirty, and so is the image.
DIRTY=""
declare -A MARK=([pedal]="" [rtpi]="" [namchain]="")
if (( DEV )); then
  for k in pedal rtpi namchain; do
    [[ -z $(git -C "${REPOS[$k]}" status --porcelain --ignore-submodules=none) ]] || { MARK[$k]=-dirty; DIRTY=-dirty; }
  done
fi
STAMP=$STAMP$DIRTY
OUT=$REPO/build/$HOST/$STAMP
IN=$OUT/in
mkdir -p "$IN"

# shellcheck disable=SC1091
source "$COMMON/image/export.sh"
if (( DEV )); then log "inputs: the working trees (--dev)"; else log "inputs: image.lock"; fi
for k in pedal rtpi namchain; do
  if (( DEV )); then export_tree "${REPOS[$k]}" worktree "$IN/$k"
  else
    git -C "${REPOS[$k]}" cat-file -e "${PIN[$k]}^{commit}" 2>/dev/null || die "$k: no commit ${PIN[$k]} in ${REPOS[$k]}"
    export_tree "${REPOS[$k]}" "${PIN[$k]}" "$IN/$k"
  fi
  printf '    %-9s %s\n' "$k" "${PIN[$k]:0:12}${MARK[$k]}" >&2
  PIN[$k]=${PIN[$k]}${MARK[$k]}
done
find "$IN" -name .DS_Store -delete

# ------------------------------------------------------------------ the pedal kernel's artefacts
# rtpi's build output, verified against the lock before any time is spent in the container. A
# kernel is the one input where a silent difference is a card that boots the wrong thing, so each
# hash is checked, and the release and kind have to agree with the lock too.
if [[ -n ${PIN[kernel]} ]]; then
  KDIR=$RTPI_REPO/build/vip
  [[ -d $KDIR ]] || die "no $KDIR: build the kernel first (make vip-rt in $RTPI_REPO)"
  got=$(cat "$KDIR/kernelrelease" 2>/dev/null || true)
  [[ $got == "${PIN[kernel]}" ]] || die "$KDIR/kernelrelease is '$got', the lock says ${PIN[kernel]}: rebuild it, or re-pin the lock"
  got=$(cat "$KDIR/build-kind" 2>/dev/null || true)
  [[ $got == "${PIN[kernel-kind]}" ]] || die "$KDIR is a '$got' build, the lock says ${PIN[kernel-kind]}"
  mkdir -p "$IN/kernel"
  copy_verified() {  # copy_verified <file> <sha256 the lock pins>
    local f=$1 want=$2 have
    [[ -s $KDIR/$f ]] || die "$KDIR/$f is missing or empty: did the build finish?"
    have=$(shasum -a 256 "$KDIR/$f" | cut -d' ' -f1)
    [[ $have == "$want" ]] || die "$f is $have, the lock pins $want: rebuild it in rtpi, or re-pin the lock"
    cp "$KDIR/$f" "$IN/kernel/"
  }
  copy_verified "boot-${PIN[kernel]}.tar.gz" "${PIN[kernel-boot-sha256]}"
  copy_verified "modules-${PIN[kernel]}.tar.gz" "${PIN[kernel-modules-sha256]}"
  for f in kernelrelease build-kind trimmed-ok.txt proc-modules bcm2712-rpi-5-b.dtb.sha256 \
           sha256sums built-from; do
    [[ -e $KDIR/$f ]] && cp "$KDIR/$f" "$IN/kernel/"
  done
  have=$(cut -d' ' -f1 "$IN/kernel/bcm2712-rpi-5-b.dtb.sha256" 2>/dev/null || true)
  [[ $have == "${PIN[kernel-dtb-sha256]}" ]] \
    || die "the built bcm2712-rpi-5-b.dtb is $have, the lock pins ${PIN[kernel-dtb-sha256]}"
  # Provenance, so a card can say which rtpi tree its kernel came from. The locked artefacts
  # predate rtpi's own stamp; the lock says so, and new builds write it themselves.
  if [[ -s $KDIR/built-from ]]; then
    got=$(cat "$KDIR/built-from")
    [[ $got == "${PIN[kernel-rtpi]}" ]] \
      || warn "the artefacts were built from rtpi $got, the lock says ${PIN[kernel-rtpi]}"
  fi
  log "kernel: ${PIN[kernel]} (${PIN[kernel-kind]}) verified against the lock"
else
  warn "no kernel= in $LOCK: the card gets only the stock kernel — no pedal kernel, no fallback slot"
fi

{ for k in snapshot pedal rtpi namchain; do echo "$k=${PIN[$k]}"; done
  for k in kernel kernel-kind kernel-rtpi kernel-boot-sha256 kernel-modules-sha256 kernel-dtb-sha256; do
    [[ -n ${PIN[$k]} ]] && echo "$k=${PIN[$k]}"
  done; } > "$IN/inputs"
printf '%s\n' "$AUTH_KEYS" > "$IN/authorized_keys"

# ------------------------------------------------------------------ build
log "container (snapshot ${PIN[snapshot]})"
TAG=pedal-build:${PIN[snapshot]}
docker build -q -t "$TAG" --build-arg SNAPSHOT="${PIN[snapshot]}" "$IN/pedal/devices/common/image" >/dev/null

secrets() {
  op read "op://$OP_VAULT/$WIFI_ITEM/network name"
  op read "op://$OP_VAULT/$WIFI_ITEM/wireless network password"
  op read "op://$OP_VAULT/$TOKEN_ITEM/password"
  op read "op://$OP_VAULT/$HOST_KEY_ITEM/private key?ssh-format=openssh"
}
log "image (about 15 minutes: namchain's build and tests, two roots, the filesystems)"
# mmdebstrap and the build's chroots mount /proc, /sys and /dev in the roots they build, which
# needs CAP_SYS_ADMIN. Nothing else does: no loop devices, no --privileged.
secrets | docker run --rm -i \
  --cap-add SYS_ADMIN --security-opt apparmor=unconfined --security-opt seccomp=unconfined \
  -e HOST="$HOST" -v "$IN:/in:ro" -v "$OUT:/out" \
  "$TAG" /in/pedal/devices/common/image/build-image
# The image's own rtpi tools, for make-card --remote to run on rescue (whose are the card's).
mkdir -p "$OUT/rescue-tools"
cp "$IN/rtpi/devices/$HOST/usr/local/sbin/vip-boot" "$IN/rtpi/devices/$HOST/usr/local/sbin/vip-reimage" \
   "$IN/rtpi/devices/$HOST/device.env" "$OUT/rescue-tools/"
rm -rf "$IN"
# Give the build's space inside colima back to the Mac.
colima ssh -- sudo fstrim -a >/dev/null 2>&1 || true

mkdir -p "$HERE/images"
cp "$OUT/manifest" "$HERE/images/$STAMP.manifest"
log "built: $OUT/$HOST.img"
log "manifest: devices/$HOST/images/$STAMP.manifest"
(( REMOTE )) && exec "$COMMON/image/remote" "$OUT" "$HOST"
(( IMAGE_ONLY )) && exit 0
exec "$COMMON/write-card" --image "$OUT/$HOST.img" "${DISK[@]}"
