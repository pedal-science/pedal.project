.DS_Store
.claude/settings.local.json
# A git worktree for a second agent on this repo. It used to live in .git/info/exclude, which is
# local to one clone and invisible to the next; here it travels. ripgrep skips `.claude` anyway
# (hidden), so ignoring it costs no search.
.claude/worktrees/
firmware/build/
# draw.io temp and backup files
.$*.dtmp
.$*.bkp
build/

# KiCad writes these while a sheet is open
~*.lck

# Python bytecode, left by importing the layout scripts
__pycache__/

# pedal-diag --watch writes its log here when run from a checkout
scratch/
