.DS_Store
.claude/settings.local.json
# A git worktree for a second agent on this repo. It used to live in .git/info/exclude, which is
# local to one clone and invisible to the next; here it travels. ripgrep skips `.claude` anyway
# (hidden), so ignoring it costs no search.
.claude/worktrees/
firmware/build/
# draw.io temp and backup files
.$*.dtmp
.$*.bkp
build/

# KiCad writes these while a sheet is open
~*.lck

# Python bytecode, left by importing the layout scripts
__pycache__/

# pedal-diag --watch writes its log here when run from a checkout
scratch/

# A backup's restore payload. `devices/<host>/backup` writes state.txt beside files.tar: the settings
# are the readable, small record of what the host looked like before a change and belong in git; the
# tar is every file it captured, ~320 KB per apply, and nothing reads it. The tars already tracked
# stay tracked -- untracking them would rewrite nothing in history and gain nothing -- but no new one
# is added, so a backup commit carries the record and not the payload.
devices/*/backups/*/files.tar

# KiCad per-user state, and netlists exported to be checked (schematic/*.py export them)
*.kicad_prl
schematic/balanced-output/balanced-output.net
