{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "proofs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rung",
          "date",
          "result",
          "evidence",
          "note"
        ],
        "properties": {
          "rung": {
            "enum": [
              "code",
              "artefacts",
              "together",
              "install",
              "device",
              "hour",
              "played"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "result": {
            "enum": [
              "pass",
              "partial",
              "fail"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
