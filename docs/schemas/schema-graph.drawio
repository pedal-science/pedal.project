e="p0n7" target="p0n4"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="545" as="sourcePoint"/><mxPoint x="263" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e10" value="lanes (≥2 after normalize)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n5" target="p0n6"><mxGeometry relative="1" as="geometry"><mxPoint x="266" y="578" as="sourcePoint"/><mxPoint x="63" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e11" value="elements 0…N — the recursion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n6" target="p0n2"><mxGeometry relative="1" as="geometry"><mxPoint x="249" y="686" as="sourcePoint"/><mxPoint x="60" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e12" value="splitMode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n5" target="p0n10"><mxGeometry relative="1" as="geometry"><mxPoint x="266" y="578" as="sourcePoint"/><mxPoint x="80" y="808" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e13" value="componentID →" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=open;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#808080;fontColor=#555555;" edge="1" parent="1" source="p0n3" target="p0n11"><mxGeometry relative="1" as="geometry"><mxPoint x="282" y="362" as="sourcePoint"/><mxPoint x="53" y="938" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 · namchain rig document"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1488" pageHeight="322" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1t" value="&lt;b&gt;2 · namchain rig document&lt;/b&gt; — what rig.apply accepts, rig.get returns, and the daemon keeps as last.json — the form a rig is transformed into" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1428.2" height="40" as="geometry"/></mxCell><mxCell id="p1n0" value="&lt;b&gt;Rig document&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;name?: string&lt;br&gt;meta?: object&lt;br&gt;chains  — or —&lt;br&gt;nodes + connections&lt;br&gt;(exactly one form)&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="118" y="90" width="153" height="96" as="geometry"/></mxCell><mxCell id="p1n1" value="&lt;b&gt;Chain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: string (non-empty)&lt;br&gt;name?: string&lt;br&gt;input_channel?: int ≥ 0&lt;br&gt;output_channel?: int ≥ 0&lt;br&gt;nodes: Node[]&lt;br&gt;connections?: Connection[]&lt;br&gt;meta?: object&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="115" width="200" height="126" as="geometry"/></mxCell><mxCell id="p1n2" value="&lt;b&gt;Node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;type: string (required)&lt;br&gt;id? · element? (one needed)&lt;br&gt;role?: string&lt;br&gt;bypass?: bool = false&lt;br&gt;params: {…: number}&lt;br&gt;strings: {…: string}&lt;br&gt;+ any other key → inline&lt;br&gt;parameter: number | bool | string&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="923" y="108" width="246" height="140" as="geometry"/></mxCell><mxCell id="p1n3" value="&lt;b&gt;Connection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;from: node id&lt;br&gt;from_port?: int = 0&lt;br&gt;to: node id&lt;br&gt;to_port?: int = 0&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="137" width="153" height="82" as="geometry"/></mxCell><mxCell id="p1n4" value="&lt;b&gt;meta&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;any object&lt;br&gt;carried, never parsed&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1265" y="90" width="167" height="53" as="geometry"/></mxCell><mxCell id="p1n5" value="&lt;b&gt;NodeType&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the node&amp;#x27;s type id,&lt;br&gt;from engine.schema (page 3).&lt;br&gt;Unknown keys are refused, not&lt;br&gt;ignored — a client&amp;#x27;s own data&lt;br&gt;goes in meta.&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1239" y="169" width="219" height="96" as="geometry"/></mxCell><mxCell id="p1n6" value="&lt;b&gt;strict by contract&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the parser (src/graph/rig.cpp) refuses unknown keys&lt;br&gt;at every level except the node&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="212" width="330" height="53" as="geometry"/></mxCell><mxCell id="p1e0" value="chains 1…N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p1n0" target="p1n1"><mxGeometry relative="1" as="geometry"><mxPoint x="272" y="138" as="sourcePoint"/><mxPoint x=