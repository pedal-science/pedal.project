<mxfile host="app.diagrams.net" modified="2026-01-01T00:00:00.000Z" agent="tools/schema-graph.py" version="24.0.0" type="device"><diagram id="p0" name="1 · ljoss rig tree"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="885" pageHeight="1121" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0t" value="&lt;b&gt;1 · ljoss rig tree&lt;/b&gt; — the designer's document — a series/parallel tree, one file per rig (&lt;uuid&gt;.rig.json)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="824.5999999999999" height="40" as="geometry"/></mxCell><mxCell id="p0n0" value="&lt;b&gt;Rig&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;name: string&lt;br&gt;layout: RigLayout&lt;br&gt;chains: SignalChain[]&lt;br&gt;createdAt / modifiedAt: ISO-8601&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="37" y="90" width="239" height="96" as="geometry"/></mxCell><mxCell id="p0n1" value="&lt;b&gt;SignalChain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;name: string&lt;br&gt;source: SourceKind&lt;br&gt;input / output: IONode&lt;br&gt;elements: ChainElement[]&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="369" y="475" width="186" height="96" as="geometry"/></mxCell><mxCell id="p0n2" value="&lt;b&gt;ChainElement&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;block: Block&lt;br&gt;parallel: ParallelSection&lt;br&gt;a series/parallel tree —&lt;br&gt;deliberately not a DAG&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="212" width="193" height="82" as="geometry"/></mxCell><mxCell id="p0n3" value="&lt;b&gt;Block&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;componentID: string (catalogue id)&lt;br&gt;isEnabled: bool = true&lt;br&gt;values: {param → ParamValue}&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="252" height="82" as="geometry"/></mxCell><mxCell id="p0n4" value="&lt;b&gt;ParamValue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;number(Double)&lt;br&gt;option(String)&lt;br&gt;flag(Bool)&lt;br&gt;on disk: {&amp;quot;case&amp;quot;: {&amp;quot;_0&amp;quot;: …}}&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="428" width="213" height="82" as="geometry"/></mxCell><mxCell id="p0n5" value="&lt;b&gt;ParallelSection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;splitMode: SplitMode = yCable&lt;br&gt;crossoverHz / balance: number&lt;br&gt;lanes: Lane[]&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="536" width="219" height="82" as="geometry"/></mxCell><mxCell id="p0n6" value="&lt;b&gt;Lane&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;elements: ChainElement[]&lt;br&gt;level: dB · pan: −1…1&lt;br&gt;isMuted · invertPhase&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="63" y="644" width="186" height="82" as="geometry"/></mxCell><mxCell id="p0n7" value="&lt;b&gt;IONode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;id: uuid&lt;br&gt;values: {param → ParamValue}&lt;br&gt;fixed endpoints — never&lt;br&gt;removable or reorderable&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="642" y="504" width="213" height="82" as="geometry"/></mxCell><mxCell id="p0n8" value="&lt;b&gt;RigLayout&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;single&lt;br&gt;dual&lt;br&gt;a viewing preference — hidden&lt;br&gt;chains are still sent&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="352" y="598" width="219" height="82" as="geometry"/></mxCell><mxCell id="p0n9" value="&lt;b&gt;SourceKind&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;guitar · bass · vocal&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="612" width="167" height="38" as="geometry"/></mxCell><mxCell id="p0n10" value="&lt;b&gt;SplitMode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;yCable&lt;br&gt;aB&lt;br&gt;crossover&lt;br&gt;dynamic&lt;br&gt;only yCable reaches&lt;br&gt;today&amp;#x27;s engine&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="752" width="153" height="111" as="geometry"/></mxCell><mxCell id="p0n11" value="&lt;b&gt;Catalogue component&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;componentID → ComponentSpec&lt;br&gt;(ParamSpec[]: kind, bounds,&lt;br&gt;default, unit)&lt;br&gt;defaults live here,&lt;br&gt;not in the rig file&lt;br&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="53" y="890" width="206" height="96" as="geometry"/></mxCell><mxCell id="p0n12" value="&lt;b&gt;one file per rig&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;saved by Store/RigLibrary.swift;&lt;br&gt;unknown keys are ignored on load&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="37" y="1012" width="239" height="53" as="geometry"/></mxCell><mxCell id="p0e0" value="chains 1…N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n0" target="p0n1"><mxGeometry relative="1" as="geometry"><mxPoint x="276" y="138" as="sourcePoint"/><mxPoint x="369" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e1" value="layout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n0" target="p0n8"><mxGeometry relative="1" as="geometry"><mxPoint x="276" y="138" as="sourcePoint"/><mxPoint x="352" y="639" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e2" value="input 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n1" target="p0n7"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="516" as="sourcePoint"/><mxPoint x="642" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e3" value="output 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#404040;" edge="1" parent="1" source="p0n1" target="p0n7"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="532" as="sourcePoint"/><mxPoint x="642" y="553" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0e4" value="source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArro