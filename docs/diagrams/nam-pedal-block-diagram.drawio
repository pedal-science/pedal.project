        <mxCell id="e7" value="I2S: BCLK, ADCLRC, DACLRC (from codec)&lt;br&gt;ADCDAT → tib · DACDAT → codec&lt;br&gt;I2C: SDA/SCL · 3V3 to codec&lt;br&gt;&lt;b&gt;keep leads &amp;lt; 10 cm&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2b6098;strokeWidth=2;startArrow=classic;startFill=1;" edge="1" parent="1" source="tib" target="codec">
