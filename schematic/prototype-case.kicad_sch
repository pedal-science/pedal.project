	(text "HPL and HPR sit at about 1.65 V DC.  A jack must never see"
		(exclude_from_sim no)
		(at 180 158.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "367234fe-a2e5-591e-abf1-c2725852c8be")
	)
	(text "them directly: always through the 10 uF (+ towards the codec)"
		(exclude_from_sim no)
		(at 180 161 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "71fa296b-ead0-50a2-838d-8cfc5075c5b1")
	)
	(text "and the 100 ohm.  The 1M holds each tip at 0 V DC."
		(exclude_from_sim no)
		(at 180 163.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "17f65276-2ea3-585a-afca-1f49b9fdb7c6")
	)
	(text "J3 pin 1 = OUT L tip, pin 2 = OUT R tip.  Pins 3 and 4 are"
		(exclude_from_sim no)
		(at 180 168.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6ad036db-f220-50fa-941b-21e59c3f8017")
	)
	(text "reserved for the INST/LINE switch and the DC socket (+9 V)."
